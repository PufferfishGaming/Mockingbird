<Window x:Class="TriAsr.App.ClientWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App" Icon="Assets/TriASR.ico" Title="{x:Static local:AppInfo.WindowTitle}" Width="1100" Height="760" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Closing="OnWindowClosing">
  <!-- DataContext: ClientViewModel. The Client edition: servers on the right, the connected server's pages in the middle. Nothing is transcribed here. -->
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="32" Height="32" Margin="0,0,13,0"><Path Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" Data="M8,16 L8,10 M13,23 L13,5 M18,19 L18,9 M23,16 L23,12" /></Border><TextBlock Text="{x:Static local:AppInfo.Name}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,2,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center"><TextBlock Text="{local:T 'TRANSCRIPTION RUNS ON THE SERVER'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /></Border><ToggleButton IsChecked="{Binding ShowServerPanel}" Content="{local:T 'Servers'}" Margin="12,0,0,0" Padding="12,6" ToolTip="{local:T 'Show or hide the panel with the servers on your network'}" AutomationProperties.Name="{local:T 'Servers'}" /></StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1">
      <local:ErrorBanner x:Name="ErrorBanner" />
      <local:UpdateBanner />
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition x:Name="ServerColumn" Width="320" /></Grid.ColumnDefinitions>
      <local:RemoteWorkspaceView DataContext="{Binding Remote}" Visibility="{Binding DataContext.Servers.HasConnection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
      <ScrollViewer x:Name="Welcome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Servers.HasConnection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel Margin="36,36,36,28" MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="{local:T 'Connect to a server'}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{local:T 'Your recordings are sent to a server, which transcribes them with the speech models installed there. The transcripts come back here to be read, edited and exported. Nothing is transcribed on this computer.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="24" Margin="0,14,0,0" />
          <TextBlock Text="{local:T 'Pick a server in the list on the right. Servers on this network appear by themselves; you can also add one by its address. Connections are encrypted, and the first time you connect you check the server\'s fingerprint.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,0" />
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,26,0,0">
            <StackPanel>
              <TextBlock Text="{local:T 'Privacy'}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{local:T 'Recordings and transcripts travel only between this computer and the server you connect to, and the connection is encrypted.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <Button Content="{local:T 'Read privacy policy'}" Click="ShowPrivacyPolicy" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="1" x:Name="ServerPanelHost" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,18,14,18">
          <local:ServerListPanel DataContext="{Binding Servers}" Margin="0,0,0,14" />
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
              <TextBlock Text="{local:T 'Appearance'}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{local:T 'Theme'}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6" />
              <ComboBox ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{local:T 'Appearance theme'}" />
              <TextBlock Text="{local:T 'Language'}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6" />
              <ComboBox ItemsSource="{Binding UiLanguages}" SelectedValue="{Binding Language}" SelectedValuePath="Code" ItemTemplate="{StaticResource NativeNameItem}" AutomationProperties.Name="{local:T 'Interface language'}" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="{local:T 'Updates'}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
              <CheckBox Content="{local:T 'Check for updates automatically'}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,12,0,0" ToolTip="{local:T 'Once at startup, at most every 12 hours. Only the release information file is requested from GitHub; no recordings, transcripts or personal data are sent.'}" AutomationProperties.Name="{local:T 'Check for updates automatically'}" />
              <Button Content="{local:T 'Check for updates now'}" Command="{Binding CheckForUpdatesNowCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /></Border>
  </Grid>
</Window>
