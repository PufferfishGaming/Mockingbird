<Window x:Class="TriAsr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App" Icon="Assets/TriASR.ico" Title="{x:Static local:AppInfo.WindowTitle}" Width="1220" Height="820" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SizeChanged="OnWindowSizeChanged" Closing="OnWindowClosing" PreviewKeyDown="OnReviewKey">
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="32" Height="32" Margin="0,0,13,0"><Path Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" Data="M8,16 L8,10 M13,23 L13,5 M18,19 L18,9 M23,16 L23,12" /></Border><TextBlock Text="Mockingbird Studio" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,2,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center"><TextBlock Text="ALL INFERENCE STAYS LOCAL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /></Border></Grid>
    </Border>
    <Border x:Name="ErrorAlert" Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="3" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Margin="16,10" Padding="18,14" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Error alert">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PulseError}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="ErrorPulse"><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.6" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="3x" FillBehavior="Stop" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ErrorPulse" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ErrorTitle}" Foreground="{DynamicResource ErrorBrush}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" /><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,6,16,0"><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" /></ScrollViewer></StackPanel><Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top" AutomationProperties.Name="Dismiss error alert" /></Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="230" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,22,12,20">
        <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Bottom" x:Name="SidebarFooter" Text="PRIVATE BY DEFAULT&#10;No uploads. No telemetry." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12,18,0,0" LineHeight="20" /><ListBox x:Name="NavigationList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="Main navigation"><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="{Binding Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Name}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Visibility="{Binding HasTranscriptionProgress, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TranscriptionStage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding TranscriptionProgressSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0" /></Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding TranscriptionPercent}" Height="8" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="Overall transcription progress" ToolTip="Progress through seven processing stages; this is not an estimate of remaining time." />
          <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsTranscriptionRunning, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Transcription is running" />
        </StackPanel>
      </Border>
      <Grid Grid.Row="1" Margin="24,18" Visibility="{Binding IsTerminalPage, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock Text="{Binding SelectedPage.Title}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Activity shows app events and engine output. PowerShell runs your commands." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
        <WrapPanel Grid.Row="1"><ComboBox ItemsSource="{Binding TerminalViews}" SelectedItem="{Binding TerminalView}" Width="155" Margin="0,0,12,10" AutomationProperties.Name="Terminal view" /><Button Content="Start PowerShell" Command="{Binding StartTerminalCommand}" Margin="0,0,10,10" /><Button Content="Stop session" Command="{Binding StopTerminalCommand}" Margin="0,0,10,10" /><Button Content="Clear view" Command="{Binding ClearTerminalCommand}" Margin="0,0,10,10" /><Button Content="Copy output" Command="{Binding CopyTerminalCommand}" Margin="0,0,10,10" /><CheckBox Content="Auto-scroll" IsChecked="{Binding TerminalAutoScroll}" VerticalAlignment="Center" Margin="0,0,0,10" /></WrapPanel>
        <TextBox Grid.Row="2" x:Name="TerminalOutputBox" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MinHeight="100" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Live terminal output" ToolTip="Latest 2,000 entries. Saved project evidence and app logs remain on disk. Full-screen console interfaces require an external terminal." />
        <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding TerminalStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding TerminalDirectory}" ToolTip="{Binding TerminalDirectory}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,5,0,0" /></StackPanel>
        <TextBox Grid.Row="4" x:Name="TerminalInputBox" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" PreviewKeyDown="TerminalInputKeyDown" AutomationProperties.Name="PowerShell command or prompt input" />
        <WrapPanel Grid.Row="5"><Button Content="{Binding TerminalSendLabel}" Command="{Binding SubmitTerminalCommand}" Margin="0,0,12,0" /><TextBlock Text="Enter runs or sends input · Shift+Enter adds a line · ↑ / ↓ history" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" /></WrapPanel>
      </Grid>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsTerminalPage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><Grid Margin="{Binding ContentMargin}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding SelectedPage.Name}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding SelectedPage.Title}" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,12" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="{Binding SelectedPage.Description}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="25" />
        <Border Grid.Row="3" Margin="0,30,0,0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="32,46" Visibility="{Binding IsEmptyPage, Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center"><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="13" Width="58" Height="58" HorizontalAlignment="Left" Margin="0,0,0,24"><Path Data="{Binding SelectedPage.Icon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="27" Height="27" Stretch="Uniform" /></Border><TextBlock Text="{Binding SelectedPage.EmptyTitle}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedPage.EmptyDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Margin="0,12,0,0" LineHeight="24" /></StackPanel></Border>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsNewPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="32" AllowDrop="True" Drop="OnFileDrop"><StackPanel>
            <TextBlock Text="Drop audio or video here" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="WAV · MP3 · M4A · AAC · FLAC · OGG · OPUS · MP4 · MKV · MOV · WEBM" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,20" />
            <Button Content="Select file" Click="SelectFileClick" HorizontalAlignment="Left" AutomationProperties.Name="Select media file" />
            <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,16,0,24" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="Language · auto detects speech language" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" DisplayMemberPath="Display" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Speech language" />
            <TextBlock Text="Performance preset" Margin="0,16,0,8" /><ComboBox ItemsSource="{Binding PerformancePresets}" SelectedItem="{Binding SelectedPreset}" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Performance preset" />
            <TextBlock Text="{Binding Readiness}" Margin="0,20,0,20" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <TextBlock Text="Presets select model variants; missing models must be downloaded before use." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <WrapPanel Margin="0,0,0,18"><Button Content="Download selected models" Command="{Binding InstallSelectedModelsCommand}" Margin="0,0,10,8" /><Button Content="Pause download" Command="{Binding CancelModelCommand}" Margin="0,0,0,8" /></WrapPanel>
            <TextBlock Text="Strict verbatim · both speech engines · local disagreement correction" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal"><Button Content="Start transcription" Command="{Binding PrepareAudioCommand}" /><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0" /><Button Content="Models and tuning" Command="{Binding GoBenchmarkCommand}" Margin="12,0,0,0" /></StackPanel>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsJobsPage, Converter={StaticResource BoolVisibility}}">
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" MinHeight="200" AutomationProperties.Name="Saved transcription jobs"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding Checkpoint}" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <WrapPanel Margin="0,18,0,0"><Button Content="Resume selected job" Command="{Binding ResumeAudioCommand}" /><Button Content="Open transcript" Command="{Binding OpenReviewCommand}" Margin="12,0,0,0" /><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0" /></WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsReviewPage, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding ReviewSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,16,0,16"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="9" AutomationProperties.Name="Search transcript" ToolTip="Search final and original text" /><CheckBox Content="Needs listening" IsChecked="{Binding UncertainOnly}" VerticalAlignment="Center" Margin="16,0,16,0" /><Button Content="Save edits" Command="{Binding SaveReviewCommand}" /><ComboBox ItemsSource="{Binding ExportModes}" SelectedItem="{Binding SelectedExportMode}" Width="150" Margin="12,0,0,0" AutomationProperties.Name="Export mode" ToolTip="Readable adjusts spacing and preserves spoken words. Strict Verbatim stays saved." /><Button Content="Export…" Click="ExportClick" Margin="12,0,0,0" /></WrapPanel>
          <ListBox ItemsSource="{Binding ReviewItems}" SelectedItem="{Binding SelectedRegion}" MaxHeight="235" MinHeight="100" AutomationProperties.Name="Transcript regions"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Time}" Foreground="{DynamicResource AccentBrush}" FontSize="12" /><TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TabControl Margin="0,18,0,0" Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="Final"><StackPanel Margin="16"><TextBlock Text="{Binding SelectedRegion.Evidence}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" /><WrapPanel Margin="0,0,0,12"><Button Content="Use Whisper · 1" Command="{Binding UseWhisperCommand}" /><Button Content="Use Canary · 2" Command="{Binding UseCanaryCommand}" Margin="8,0,0,0" /><Button Content="Use AI · 3" Command="{Binding UseAiCommand}" Margin="8,0,0,0" /></WrapPanel><TextBox x:Name="TranscriptEditor" Text="{Binding SelectedRegion.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Padding="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Edit selected transcript region" /></StackPanel></TabItem>
            <TabItem Header="Comparison"><StackPanel Margin="16"><TextBlock Text="WHISPER" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBox Text="{Binding SelectedRegion.Whisper, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,5,0,12" /><TextBlock Text="{Binding SelectedRegion.CanaryHeading}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBox Text="{Binding SelectedRegion.Canary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,5,0,12" /><TextBlock Text="FINAL" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedRegion.Text}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></TabItem>
            <TabItem Header="Raw"><StackPanel Margin="16"><TextBlock Text="Original ASR text is immutable. Full transcripts are shown below. Native JSON and runtime output are retained in the job folder." TextWrapping="Wrap" Margin="0,0,0,12" /><TextBox Text="{Binding RawWhisper, Mode=OneWay}" IsReadOnly="True" MaxHeight="250" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8" /><TextBox Text="{Binding RawCanary, Mode=OneWay}" IsReadOnly="True" MaxHeight="250" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8" Margin="0,12,0,0" /></StackPanel></TabItem>
          </TabControl>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsModelsPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
            <TextBlock Text="Your recommended setup" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SystemSummary}" TextWrapping="Wrap" Margin="0,12,0,8" />
            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding RecommendedDownloadSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
            <WrapPanel><Button Content="1 · Check my computer" Command="{Binding DetectHardwareCommand}" Margin="0,0,10,10" /><Button Content="2 · Download recommended models" Command="{Binding InstallRecommendedCommand}" Margin="0,0,10,10" /><Button Content="3 · Tune performance" Command="{Binding GoBenchmarkCommand}" Margin="0,0,0,10" /></WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsCheckingSystem, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Checking your system" />
            <TextBlock Text="Highlighted cards are recommended or in use. Downloading also saves the selected models. Already downloaded files are reused; closing the app never removes models." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
          </StackPanel></Border>
          <ListBox ItemsSource="{Binding ModelCards}" SelectedItem="{Binding SelectedModel}" Margin="0,18,0,0" MaxHeight="440" AutomationProperties.Name="Local models"><ListBox.ItemTemplate><DataTemplate>
            <Border Padding="14" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Highlighted}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
              <WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="   RECOMMENDED" Visibility="{Binding Recommended, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Text="   IN USE" Visibility="{Binding Selected, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" /></WrapPanel>
              <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" Height="4" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Model download progress" />
              <TextBlock Text="{Binding Location}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel></Border>
          </DataTemplate></ListBox.ItemTemplate></ListBox>
          <WrapPanel Margin="0,18,0,0"><Button Content="Download / resume chosen model" Command="{Binding InstallModelCommand}" Margin="0,0,8,10" /><Button Content="Verify file" Command="{Binding VerifyModelCommand}" Margin="0,0,8,10" /><Button Content="Use this model" Command="{Binding SelectModelCommand}" Margin="0,0,8,10" /><Button Content="Open folder" Command="{Binding OpenModelFolderCommand}" Margin="0,0,8,10" /><Button Content="Pause download" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
          <ProgressBar Value="{Binding ModelDownloadPercent}" Maximum="100" Height="8" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Current model download" />
          <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsBenchmarkPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
            <TextBlock Text="1 · Check your system" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SystemSummary}" TextWrapping="Wrap" Margin="0,10,0,10" />
            <Button Content="Check my computer" Command="{Binding DetectHardwareCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="2 · Get the recommended models" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,10" />
            <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding ModelCards}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Visibility="{Binding Recommended, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" /></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding RecommendedDownloadSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
            <WrapPanel><Button Content="Download recommended models" Command="{Binding InstallRecommendedCommand}" Margin="0,0,10,8" /><Button Content="Pause download" Command="{Binding CancelModelCommand}" Margin="0,0,0,8" /></WrapPanel>
            <ProgressBar Value="{Binding ModelDownloadPercent}" Maximum="100" Height="8" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
            <TextBlock Text="3 · Measure and save the best settings" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,10" />
            <TextBlock Text="Use at least three seconds of representative speech. Tuning tests up to eight seconds: one warmup, then three timed runs for each setting. CPU tests may take several minutes." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="Choose tuning recording…" Click="SelectFileClick" HorizontalAlignment="Left" /><TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource TextMutedBrush}" />
            <WrapPanel><Button Content="Run auto-tuning" Command="{Binding OptimizeCommand}" Margin="0,0,10,8" /><Button Content="Cancel tuning" Command="{Binding CancelBenchmarkCommand}" Margin="0,0,0,8" /></WrapPanel>
          </StackPanel></Border>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,18,0,0" Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolVisibility}}" />
          <TextBlock Text="{Binding BenchmarkProgress}" TextWrapping="Wrap" Margin="0,18,0,18" />
          <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="{Binding BenchmarkSummary}" TextWrapping="Wrap" /><Button Content="Apply all best settings" Command="{Binding ApplyBestSettingsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" ToolTip="Apply the measured backend, CPU threads and speech execution strategy for every engine. Saved models are unchanged." /></StackPanel></Border>
          <TextBlock Text="How to read the results" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12" />
          <TextBlock Text="Seconds (median): the middle of three timings; lower is faster. Speech engine timings include model loading. Audio/time ratio (RTF): processing time divided by audio duration. 0.5 means 10 seconds of audio took 5 seconds; 2 means it took 20 seconds. Lower is better." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
          <TextBlock Text="CPU / GPU tells you where the model ran. Threads are CPU workers; more does not always mean faster. Dual ASR compares both engines together versus one after the other. Correction measures seconds per disagreement with the model already loaded, so it has no audio/time ratio. These are speed tests, not accuracy tests; short samples do not predict exact completion time for long recordings." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
          <DataGrid ItemsSource="{Binding BenchmarkResults}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="430" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource SurfaceElevatedBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}"><DataGrid.Columns>
            <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" /><DataGridTextColumn Header="Model" Binding="{Binding Model}" /><DataGridTextColumn Header="Runs on" Binding="{Binding BackendLabel}" /><DataGridTextColumn Header="Threads" Binding="{Binding ThreadLabel}" /><DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" /><DataGridTextColumn Header="Seconds (median)" Binding="{Binding MedianSeconds, StringFormat=F3}" /><DataGridTextColumn Header="Audio/time ratio" Binding="{Binding RealTimeFactor, StringFormat=F3}" /><DataGridTextColumn Header="What this means" Binding="{Binding Meaning}" /><DataGridTextColumn Header="Issue (excluded)" Binding="{Binding Error}" />
          </DataGrid.Columns></DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsLanguagesPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel>
            <TextBlock Text="100 languages in one multilingual model" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Whisper Large v3 auto-detects all 100 languages listed below. Language expansions reuse the shared model download. Canary adds independent comparison for 25 languages. Other languages use Whisper with native timestamps and are marked for listening; language accuracy varies." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,18" />
            <TextBlock Text="{Binding SavedLanguageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" />
            <TextBox Text="{Binding LanguageSearch, UpdateSourceTrigger=PropertyChanged}" Padding="10" ToolTip="Search a language or code" AutomationProperties.Name="Search language expansions" />
            <ListBox ItemsSource="{Binding ExpansionLanguages}" SelectedItem="{Binding SelectedExpansionLanguage}" DisplayMemberPath="Display" MaxHeight="260" Margin="0,12,0,16" AutomationProperties.Name="Available language expansions" />
            <TextBlock Text="{Binding LanguageCoverage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
            <WrapPanel><Button Content="Download / set up this language" Command="{Binding InstallLanguageSupportCommand}" Margin="0,0,10,10" /><Button Content="Use this language" Command="{Binding UseExpansionLanguageCommand}" Margin="0,0,10,10" /><Button Content="Pause download" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
            <ProgressBar Maximum="100" Value="{Binding ModelDownloadPercent}" Height="8" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding LanguageSetupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,10" />
            <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsBackendsPage, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding SystemSummary}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <TextBlock Text="CPU works on every supported computer. Vulkan is bundled for compatible GPUs. CUDA runs on NVIDIA GPUs; ROCm / HIP runs on supported AMD GPUs. GPU drivers and matching runtime dependencies are required. DirectML, SYCL and NPU execution are not integrated into these bundled engines." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18" />
          <DataGrid ItemsSource="{Binding BackendStatus}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="300" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" RowBackground="{DynamicResource SurfaceElevatedBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"><DataGrid.Columns><DataGridTextColumn Header="Engine" Binding="{Binding Engine}" /><DataGridTextColumn Header="Backend" Binding="{Binding Backend}" /><DataGridTextColumn Header="Availability" Binding="{Binding Status}" Width="*" /></DataGrid.Columns></DataGrid>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="Optional GPU runtime packages" FontSize="20" FontWeight="SemiBold" />
            <WrapPanel Margin="0,14,0,14"><ComboBox ItemsSource="{Binding BackendEngines}" SelectedItem="{Binding RuntimeEngine}" Width="150" Margin="0,0,10,10" AutomationProperties.Name="Runtime package engine" /><ComboBox ItemsSource="{Binding BackendPackages}" SelectedValue="{Binding RuntimeBackend}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="200" Margin="0,0,10,10" AutomationProperties.Name="Runtime package backend" /></WrapPanel>
            <WrapPanel><Button Content="Download official runtime" Command="{Binding DownloadBackendCommand}" Margin="0,0,10,10" /><Button Content="Import runtime folder…" Click="ImportRuntimeClick" Margin="0,0,10,10" /><Button Content="Pause" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
            <TextBlock Text="Official pinned downloads: CUDA for all three engines, ROCm for correction. Whisper/Canary ROCm builds can be imported; Canary must use ABI 0.2.4. Packages stay in your model repository. A matching HIP installation may still be needed. Tuning verifies actual GPU use before a result can be applied." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,12" />
            <TextBlock Text="{Binding BackendProgress}" TextWrapping="Wrap" />
          </StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="Execution settings for new jobs" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveBackendSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,16" />
            <TextBlock Text="Whisper · backend / CPU threads" Margin="0,0,0,8" /><WrapPanel><ComboBox ItemsSource="{Binding WhisperBackendChoices}" SelectedValue="{Binding WhisperBackendChoice}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="230" Margin="0,0,12,12" /><ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding WhisperThreadChoice}" Width="85" Margin="0,0,0,12" AutomationProperties.Name="Whisper CPU threads" /></WrapPanel>
            <TextBlock Text="Canary · backend / CPU threads" Margin="0,0,0,8" /><WrapPanel><ComboBox ItemsSource="{Binding CanaryBackendChoices}" SelectedValue="{Binding CanaryBackendChoice}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="230" Margin="0,0,12,12" /><ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding CanaryThreadChoice}" Width="85" Margin="0,0,0,12" AutomationProperties.Name="Canary CPU threads" /></WrapPanel>
            <TextBlock Text="Correction · backend / CPU threads" Margin="0,0,0,8" /><WrapPanel><ComboBox ItemsSource="{Binding CorrectionBackendChoices}" SelectedValue="{Binding CorrectionBackendChoice}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="230" Margin="0,0,12,12" /><ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding CorrectionThreadChoice}" Width="85" Margin="0,0,0,12" AutomationProperties.Name="Correction CPU threads" /></WrapPanel>
            <CheckBox Content="Run Whisper and Canary in parallel" IsChecked="{Binding ParallelChoice}" Margin="0,0,0,16" />
            <WrapPanel><Button Content="Save these settings" Command="{Binding SaveBackendSettingsCommand}" Margin="0,0,12,10" /><Button Content="Find best settings with auto-tuning" Command="{Binding GoBenchmarkCommand}" Margin="0,0,0,10" /></WrapPanel>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsDiagnosticsPage, Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><Button Content="Refresh hardware" Command="{Binding DetectHardwareCommand}" /><Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" Margin="12,0,0,0" /></StackPanel><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="18" TextWrapping="Wrap" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Hardware diagnostics" /></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26"><StackPanel><TextBlock Text="Appearance" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Appearance theme" /><CheckBox Content="Pulse red error alerts (three slow pulses)" IsChecked="{Binding AnimateErrors}" Margin="0,16,0,8" /><TextBlock Text="{Binding ThemeSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,9,0,24" /><TextBlock Text="Density" FontWeight="SemiBold" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Densities}" SelectedItem="{Binding SelectedDensity}" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Interface density" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="Privacy" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Transcription stays local. Requested downloads contact their providers. Terminal commands can access the network." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24" /><Button Content="Read privacy policy" Click="ShowPrivacyPolicy" HorizontalAlignment="Left" Margin="0,14,0,0" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="Storage" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,16" /><WrapPanel><Button Content="Choose projects folder" Tag="data" Click="ChooseStorageFolder" /><Button Content="Choose models folder" Tag="models" Click="ChooseStorageFolder" Margin="12,0,0,0" /></WrapPanel><TextBlock Text="Changes apply after restart. Choose the folder containing Models and models to reuse an existing model repository." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" /></StackPanel></Border>
        </StackPanel>
      </Grid></ScrollViewer>
        <Border Grid.Row="2" Visibility="{Binding IsReviewPage, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="20,12,20,16"><StackPanel>
            <MediaElement x:Name="Player" Source="{Binding AudioSource}" LoadedBehavior="Manual" UnloadedBehavior="Close" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" Height="0" />
            <local:WaveformView SourcePath="{Binding NormalizedAudioPath}" Height="48" Margin="0,0,0,10" MouseLeftButtonUp="WaveformSeek" ToolTip="Click to seek in the recording" />
            <Slider x:Name="SeekSlider" Minimum="0" PreviewMouseLeftButtonUp="OnSeek" AutomationProperties.Name="Audio position" />
            <WrapPanel Margin="0,10,0,0"><Button Content="Play region" Click="PlayRegionClick" /><Button Content="Pause" Click="PauseClick" Margin="8,0,0,0" /><Button Content="−5 s" Click="BackClick" Margin="8,0,0,0" /><Button Content="+5 s" Click="ForwardClick" Margin="8,0,0,0" /><ComboBox x:Name="SpeedPicker" Width="85" Margin="12,0,0,0" SelectedIndex="2" SelectionChanged="OnSpeedChanged" AutomationProperties.Name="Playback speed"><ComboBoxItem Content="0.5×" Tag="0.5" /><ComboBoxItem Content="0.75×" Tag="0.75" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="1.25×" Tag="1.25" /><ComboBoxItem Content="1.5×" Tag="1.5" /><ComboBoxItem Content="2×" Tag="2" /></ComboBox><TextBlock x:Name="PlayerTime" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /></WrapPanel>
          </StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" MaxWidth="330" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding EngineStatus}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" /></Grid></Border>
  </Grid>
</Window>

