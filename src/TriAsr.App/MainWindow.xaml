<Window x:Class="TriAsr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App" Icon="Assets/TriASR.ico" Title="{x:Static local:AppInfo.WindowTitle}" Width="1220" Height="820" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SizeChanged="OnWindowSizeChanged" Closing="OnWindowClosing" PreviewKeyDown="OnReviewKey">
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="32" Height="32" Margin="0,0,13,0"><Path Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" Data="M8,16 L8,10 M13,23 L13,5 M18,19 L18,9 M23,16 L23,12" /></Border><TextBlock Text="Mockingbird Studio" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,2,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center"><TextBlock Text="{local:T 'ALL INFERENCE STAYS LOCAL'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /></Border></StackPanel></Grid>
    </Border>
    <local:ErrorBanner x:Name="ErrorBanner" Grid.Row="1" />
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="230" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,22,12,20">
        <DockPanel LastChildFill="True"><Button DockPanel.Dock="Bottom" x:Name="AdvancedToggle" Command="{Binding ToggleAdvancedCommand}" Padding="12,10" Margin="0,10,0,0" ToolTip="{local:T 'Languages, backends, benchmark, diagnostics and terminal'}" AutomationProperties.Name="{local:T 'Advanced pages'}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal"><Grid Width="22"><Path Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6" Width="12" Height="7" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M0,0 L5,5 L10,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowAdvanced}" Value="True"><Setter Property="Data" Value="M0,5 L5,0 L10,5" /></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid><TextBlock Text="{local:T 'Advanced'}" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button><ListBox x:Name="NavigationList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="{local:T 'Main navigation'}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Advanced}" Value="True" /><Condition Binding="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Name}" Value="Remote server" /><Condition Binding="{Binding DataContext.Servers.HasConnection, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{local:Tr Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="{Binding Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{local:Tr Name}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
      <local:UpdateBanner />
      <local:SetupBanner />
      <Border Visibility="{Binding HasTranscriptionProgress, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TranscriptionStage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding TranscriptionProgressSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0" /></Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding TranscriptionPercent, Mode=OneWay}" Height="8" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="{local:T 'Overall transcription progress'}" ToolTip="{local:T 'Progress through seven processing stages; this is not an estimate of remaining time.'}" />
          <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsTranscriptionRunning, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Transcription is running'}" />
        </StackPanel>
      </Border>
      </StackPanel>
      <Grid Grid.Row="1" Margin="24,18" Visibility="{Binding IsTerminalPage, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock Text="{local:Tr SelectedPage.Title}" FontSize="24" FontWeight="SemiBold" /></StackPanel>
        <WrapPanel Grid.Row="1"><ComboBox ItemsSource="{Binding TerminalViews}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding TerminalView}" Width="155" Margin="0,0,12,10" AutomationProperties.Name="{local:T 'Terminal view'}" /><Button Content="{local:T 'Start PowerShell'}" Command="{Binding StartTerminalCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Stop session'}" Command="{Binding StopTerminalCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Clear view'}" Command="{Binding ClearTerminalCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Copy output'}" Command="{Binding CopyTerminalCommand}" Margin="0,0,10,10" /><CheckBox Content="{local:T 'Auto-scroll'}" IsChecked="{Binding TerminalAutoScroll}" VerticalAlignment="Center" Margin="0,0,0,10" /></WrapPanel>
        <TextBox Grid.Row="2" x:Name="TerminalOutputBox" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MinHeight="100" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{local:T 'Live terminal output'}" ToolTip="{local:T 'Latest 2,000 entries. Saved project evidence and app logs remain on disk. Full-screen console interfaces require an external terminal.'}" />
        <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding TerminalStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding TerminalDirectory}" ToolTip="{Binding TerminalDirectory}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,5,0,0" /></StackPanel>
        <TextBox Grid.Row="4" x:Name="TerminalInputBox" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" PreviewKeyDown="TerminalInputKeyDown" AutomationProperties.Name="{local:T 'PowerShell command or prompt input'}" />
        <WrapPanel Grid.Row="5"><Button Content="{Binding TerminalSendLabel}" Command="{Binding SubmitTerminalCommand}" Margin="0,0,12,0" /><TextBlock Text="{local:T 'Enter runs or sends input · Shift+Enter adds a line · ↑ / ↓ history'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" /></WrapPanel>
      </Grid>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsTerminalPage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsRemotePage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><Grid Margin="{Binding ContentMargin}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="{local:Tr SelectedPage.Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsNewPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="32" AllowDrop="True" Drop="OnFileDrop"><StackPanel>
            <TextBlock Text="{local:T 'Drop audio or video here'}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{local:T 'WAV, MP3, M4A, FLAC, MP4, MKV and more'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
            <Button Content="{local:T 'Select file'}" Click="SelectFileClick" HorizontalAlignment="Left" AutomationProperties.Name="{local:T 'Select media file'}" />
            <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <WrapPanel Margin="0,24,0,0">
              <StackPanel Margin="0,0,16,0"><TextBlock Text="{local:T 'Language'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="220" AutomationProperties.Name="{local:T 'Speech language'}" /></StackPanel>
              <StackPanel><TextBlock Text="{local:T 'Preset'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding PerformancePresets}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedPreset}" Width="220" AutomationProperties.Name="{local:T 'Performance preset'}" /></StackPanel>
            </WrapPanel>
            <Border Visibility="{Binding ShowReadinessCard, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,24,0,0">
              <StackPanel>
                <TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0"><Button Content="{local:T 'Download models'}" Command="{Binding InstallSelectedModelsCommand}" Margin="0,0,10,0" /><Button Content="{local:T 'Pause'}" Command="{Binding CancelModelCommand}" /></WrapPanel>
                <ProgressBar Value="{Binding ModelDownloadPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Model download progress'}" />
                <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0"><Button Content="{local:T 'Start transcription'}" Command="{Binding PrepareAudioCommand}" /><Button Content="{local:T 'Cancel'}" Command="{Binding CancelCommand}" Margin="12,0,0,0" /></StackPanel>
          </StackPanel></Border>
          <local:RecorderCard DataContext="{Binding Recorder}" Margin="0,18,0,0" />
          <local:LinkCard DataContext="{Binding Link}" Margin="0,18,0,0" />
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="32" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="{local:T 'Watch a folder'}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="{local:T 'Recordings added to the folder are transcribed automatically, one after another. Files already in the folder are left alone.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
              <WrapPanel>
                <Button Content="{local:T 'Choose folder…'}" Click="ChooseWatchFolderClick" Margin="0,0,10,8" AutomationProperties.Name="{local:T 'Choose watch folder'}" />
                <Button Content="{local:T 'Open folder'}" Command="{Binding OpenWatchFolderCommand}" Margin="0,0,10,8" IsEnabled="{Binding HasWatchFolder}" />
                <CheckBox Content="{local:T 'Watching'}" IsChecked="{Binding WatchEnabled}" IsEnabled="{Binding HasWatchFolder}" VerticalAlignment="Center" Margin="6,0,0,8" AutomationProperties.Name="{local:T 'Watch this folder'}" />
              </WrapPanel>
              <WrapPanel Margin="0,4,0,0">
                <StackPanel Margin="0,0,16,0"><TextBlock Text="{local:T 'Language'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding WatchLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="220" AutomationProperties.Name="{local:T 'Watch folder language'}" /></StackPanel>
                <StackPanel><TextBlock Text="{local:T 'Save transcript as'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding WatchOutputs}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding WatchOutput}" Width="220" AutomationProperties.Name="{local:T 'Watch folder output'}" ToolTip="{local:T 'Text and subtitle files are saved next to the recording and never replace an existing file; Project only saves none. Every transcript is also kept in Projects.'}" /></StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding WatchStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsJobsPage, Converter={StaticResource BoolVisibility}}">
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" MinHeight="200" AutomationProperties.Name="{local:T 'Saved transcription jobs'}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{local:Tr State}" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" /><TextBlock Text="{local:Tr Checkpoint, Kind=Checkpoint}" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{local:Tr Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Text="{local:T 'Nothing here yet. Finished transcriptions are listed here.'}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Jobs.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <WrapPanel Margin="0,18,0,0"><Button Content="{local:T 'Resume'}" Command="{Binding ResumeAudioCommand}" /><Button Content="{local:T 'Open transcript'}" Command="{Binding OpenReviewCommand}" Margin="12,0,0,0" /><Button Content="{local:T 'Cancel'}" Command="{Binding CancelCommand}" Margin="12,0,0,0" /></WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsReviewPage, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding ReviewSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,16,0,16"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="9" AutomationProperties.Name="{local:T 'Search transcript'}" ToolTip="{local:T 'Search final and original text'}" /><CheckBox Content="{local:T 'Needs listening'}" IsChecked="{Binding UncertainOnly}" VerticalAlignment="Center" Margin="16,0,16,0" /><Button Content="{local:T 'Save edits'}" Command="{Binding SaveReviewCommand}" /><ComboBox ItemsSource="{Binding ExportModes}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedExportMode}" Width="150" Margin="12,0,0,0" AutomationProperties.Name="{local:T 'Export mode'}" ToolTip="{local:T 'Readable adjusts spacing without changing the spoken words. Strict Verbatim exports the current transcript without readability adjustments.'}" /><Button Content="{local:T 'Export…'}" Click="ExportClick" Margin="12,0,0,0" /></WrapPanel>
          <ListBox x:Name="RegionList" ItemsSource="{Binding ReviewItems}" SelectedItem="{Binding SelectedRegion}" MaxHeight="235" MinHeight="100" AutomationProperties.Name="{local:T 'Transcript regions'}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Time}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{local:Tr Source, Kind=Source}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel><local:KaraokeTextBlock Grid.Column="1" KaraokeText="{Binding Text}" Progress="{Binding PlayProgress}" TextWrapping="Wrap" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TabControl Margin="0,18,0,0" Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="{local:T 'Final'}"><StackPanel Margin="16"><TextBlock Text="{Binding SelectedRegion.Evidence}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" /><WrapPanel Margin="0,0,0,12"><Button Content="{local:T 'Use Whisper · 1'}" Command="{Binding UseWhisperCommand}" /><Button Content="{local:T 'Use Canary · 2'}" Command="{Binding UseCanaryCommand}" Margin="8,0,0,0" /><Button Content="{local:T 'Restore automatic result · 3'}" Command="{Binding UseAutomaticCommand}" Margin="8,0,0,0" /></WrapPanel><TextBox x:Name="TranscriptEditor" Text="{Binding SelectedRegion.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Padding="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="{local:T 'Edit selected transcript region'}" /></StackPanel></TabItem>
            <TabItem Header="{local:T 'Comparison'}"><StackPanel Margin="16"><TextBlock Text="{local:T 'WHISPER'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBox Text="{Binding SelectedRegion.Whisper, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,5,0,12" /><TextBlock Text="{Binding SelectedRegion.CanaryHeading}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBox Text="{Binding SelectedRegion.Canary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,5,0,12" /><TextBlock Text="{local:T 'FINAL'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedRegion.Text}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></TabItem>
            <TabItem Header="{local:T 'Raw'}"><StackPanel Margin="16"><TextBlock Text="{local:T 'Original engine output (read-only).'}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" /><TextBox Text="{Binding RawWhisper, Mode=OneWay}" IsReadOnly="True" MaxHeight="250" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8" /><TextBox Text="{Binding RawCanary, Mode=OneWay}" IsReadOnly="True" MaxHeight="250" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8" Margin="0,12,0,0" /></StackPanel></TabItem>
          </TabControl>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsModelsPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
            <TextBlock Text="{local:T 'Recommended for this computer'}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SystemSummary}" TextWrapping="Wrap" Margin="0,12,0,8" />
            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding RecommendedDownloadSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
            <WrapPanel><Button Content="{local:T 'Set up automatically'}" Command="{Binding RunSetupCommand}" Margin="0,0,10,10" ToolTip="{local:T 'Checks this computer, downloads the recommended speech models if needed and measures its speed with a short test recording.'}" /><Button Content="{local:T 'Check my computer'}" Command="{Binding DetectHardwareCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Download recommended models'}" Command="{Binding InstallRecommendedCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Tune performance'}" Command="{Binding GoBenchmarkCommand}" Margin="0,0,0,10" /></WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsCheckingSystem, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Checking your system'}" />
          </StackPanel></Border>
          <ListBox ItemsSource="{Binding ModelCards}" SelectedItem="{Binding SelectedModel}" Margin="0,18,0,0" MaxHeight="440" AutomationProperties.Name="{local:T 'Local models'}"><ListBox.ItemTemplate><DataTemplate>
            <Border Padding="14" CornerRadius="6"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Highlighted}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
              <WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{local:T 'RECOMMENDED'}" Margin="12,0,0,0" Visibility="{Binding Recommended, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Text="{local:T 'IN USE'}" Margin="12,0,0,0" Visibility="{Binding Selected, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" /></WrapPanel>
              <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ProgressBar Value="{Binding DownloadPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{local:T 'Model download progress'}" />
              <TextBlock Text="{Binding Location}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel></Border>
          </DataTemplate></ListBox.ItemTemplate></ListBox>
          <WrapPanel Margin="0,18,0,0"><Button Content="{local:T 'Download'}" Command="{Binding InstallModelCommand}" Margin="0,0,8,10" /><Button Content="{local:T 'Verify'}" Command="{Binding VerifyModelCommand}" Margin="0,0,8,10" /><Button Content="{local:T 'Use this model'}" Command="{Binding SelectModelCommand}" Margin="0,0,8,10" /><Button Content="{local:T 'Open folder'}" Command="{Binding OpenModelFolderCommand}" Margin="0,0,8,10" /><Button Content="{local:T 'Pause'}" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
          <ProgressBar Value="{Binding ModelDownloadPercent, Mode=OneWay}" Maximum="100" Height="8" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Current model download'}" />
          <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsServersPage, Converter={StaticResource BoolVisibility}}">
          <local:ServerListPanel DataContext="{Binding Servers}" Width="400" Margin="0,0,18,18" VerticalAlignment="Top" />
          <local:HostPanel DataContext="{Binding Host}" Width="400" Margin="0,0,18,18" VerticalAlignment="Top" />
        </WrapPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsBenchmarkPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
            <TextBlock Text="{local:T 'Measures every setting on this computer and keeps the fastest. Use at least three seconds of typical speech; CPU tests can take several minutes. Download the recommended models first (Models).'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <Button Content="{local:T 'Choose tuning recording…'}" Click="SelectFileClick" HorizontalAlignment="Left" /><TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource TextMutedBrush}" />
            <WrapPanel><Button Content="{local:T 'Run auto-tuning'}" Command="{Binding OptimizeCommand}" Margin="0,0,10,8" /><Button Content="{local:T 'Cancel tuning'}" Command="{Binding CancelBenchmarkCommand}" Margin="0,0,0,8" /></WrapPanel>
          </StackPanel></Border>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,18,0,0" Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolVisibility}}" />
          <TextBlock Text="{Binding BenchmarkProgress}" TextWrapping="Wrap" Margin="0,18,0,18" />
          <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="{Binding BenchmarkSummary}" TextWrapping="Wrap" /><Button Content="{local:T 'Apply all best settings'}" Command="{Binding ApplyBestSettingsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" ToolTip="{local:T 'Apply the measured backend, CPU threads and speech execution strategy for every engine. Saved models are unchanged.'}" /></StackPanel></Border>
          <Expander Header="{local:T 'How to read the results'}" Margin="0,22,0,12">
            <StackPanel Margin="20,6,0,0">
              <TextBlock Text="{local:T 'Seconds (median): the middle of three timings, lower is faster; engine timings include model loading. Time/audio ratio: processing time divided by audio length, so 0.5 means 10 seconds of audio took 5 seconds.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
              <TextBlock Text="{local:T 'These are speed tests, not accuracy tests, and short samples do not predict the exact time of a long recording.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Expander>
          <DataGrid ItemsSource="{Binding BenchmarkResults}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="430" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource SurfaceElevatedBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}"><DataGrid.Columns>
            <DataGridTextColumn Header="{local:T 'Engine'}" Binding="{local:Tr Engine}" /><DataGridTextColumn Header="{local:T 'Model'}" Binding="{Binding Model}" /><DataGridTextColumn Header="{local:T 'Runs on'}" Binding="{local:Tr ., Kind=BenchmarkBackend}" /><DataGridTextColumn Header="{local:T 'Threads'}" Binding="{Binding ThreadLabel}" /><DataGridTextColumn Header="{local:T 'Strategy'}" Binding="{local:Tr Strategy}" /><DataGridTextColumn Header="{local:T 'Seconds (median)'}" Binding="{Binding MedianSeconds, StringFormat=F3}" /><DataGridTextColumn Header="{local:T 'Time/audio ratio'}" Binding="{Binding RealTimeFactor, StringFormat=F3}" /><DataGridTextColumn Header="{local:T 'What this means'}" Binding="{local:Tr ., Kind=BenchmarkMeaning}" /><DataGridTextColumn Header="{local:T 'Issue (excluded)'}" Binding="{local:Tr Error}" />
          </DataGrid.Columns></DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsLanguagesPage, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel>
            <TextBlock Text="{local:T '100 languages, one model'}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{local:T 'Whisper can transcribe all the languages listed below. Canary provides a second transcription for 25 of them. Transcripts in the other languages are marked for listening.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,16" />
            <TextBlock Text="{Binding SavedLanguageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" />
            <TextBox Text="{Binding LanguageSearch, UpdateSourceTrigger=PropertyChanged}" Padding="10" ToolTip="{local:T 'Search a language or code'}" AutomationProperties.Name="{local:T 'Search language expansions'}" />
            <ListBox ItemsSource="{Binding ExpansionLanguages}" SelectedItem="{Binding SelectedExpansionLanguage}" ItemTemplate="{StaticResource TranslatedItem}" MaxHeight="260" Margin="0,12,0,16" AutomationProperties.Name="{local:T 'Available language expansions'}" />
            <TextBlock Text="{Binding LanguageCoverage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
            <WrapPanel><Button Content="{local:T 'Set up this language'}" Command="{Binding InstallLanguageSupportCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Use this language'}" Command="{Binding UseExpansionLanguageCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Pause'}" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
            <ProgressBar Maximum="100" Value="{Binding ModelDownloadPercent, Mode=OneWay}" Height="8" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding LanguageSetupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,10" />
            <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding IsBackendsPage, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding SystemSummary}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <TextBlock Text="{local:T 'CPU works everywhere and Vulkan is bundled for compatible GPUs. CUDA (NVIDIA) and ROCm (AMD) need matching GPU drivers.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
          <DataGrid ItemsSource="{Binding BackendStatus}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="300" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" RowBackground="{DynamicResource SurfaceElevatedBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"><DataGrid.Columns><DataGridTextColumn Header="{local:T 'Engine'}" Binding="{local:Tr Engine}" /><DataGridTextColumn Header="{local:T 'Backend'}" Binding="{Binding Backend}" /><DataGridTextColumn Header="{local:T 'Availability'}" Binding="{Binding Status}" Width="*" /></DataGrid.Columns></DataGrid>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="{local:T 'Optional GPU runtime packages'}" FontSize="20" FontWeight="SemiBold" />
            <WrapPanel Margin="0,14,0,14"><ComboBox ItemsSource="{Binding BackendEngines}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding RuntimeEngine}" Width="150" Margin="0,0,10,10" AutomationProperties.Name="{local:T 'Runtime package engine'}" /><ComboBox ItemsSource="{Binding BackendPackages}" SelectedValue="{Binding RuntimeBackend}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="200" Margin="0,0,10,10" AutomationProperties.Name="{local:T 'Runtime package backend'}" /></WrapPanel>
            <WrapPanel><Button Content="{local:T 'Download official runtime'}" Command="{Binding DownloadBackendCommand}" Margin="0,0,10,10" ToolTip="{local:T 'Fixed-version CUDA builds for all three engines and ROCm for correction. Whisper and Canary ROCm builds can be imported instead (Canary needs ABI 0.2.4). A matching HIP installation may still be needed.'}" /><Button Content="{local:T 'Import runtime folder…'}" Click="ImportRuntimeClick" Margin="0,0,10,10" /><Button Content="{local:T 'Pause'}" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
            <TextBlock Text="{Binding BackendProgress}" TextWrapping="Wrap" />
          </StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="{local:T 'Execution settings for new jobs'}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveBackendSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,16" />
            <TextBlock Text="{local:T 'Whisper · backend / CPU threads'}" Margin="0,0,0,8" /><WrapPanel><ComboBox ItemsSource="{Binding WhisperBackendChoices}" SelectedValue="{Binding WhisperBackendChoice}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="230" Margin="0,0,12,12" /><ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding WhisperThreadChoice}" Width="85" Margin="0,0,0,12" AutomationProperties.Name="{local:T 'Whisper CPU threads'}" /></WrapPanel>
            <TextBlock Text="{local:T 'Canary · backend / CPU threads'}" Margin="0,0,0,8" /><WrapPanel><ComboBox ItemsSource="{Binding CanaryBackendChoices}" SelectedValue="{Binding CanaryBackendChoice}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="230" Margin="0,0,12,12" /><ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding CanaryThreadChoice}" Width="85" Margin="0,0,0,12" AutomationProperties.Name="{local:T 'Canary CPU threads'}" /></WrapPanel>
            <TextBlock Text="{local:T 'Correction · backend / CPU threads'}" Margin="0,0,0,8" /><WrapPanel><ComboBox ItemsSource="{Binding CorrectionBackendChoices}" SelectedValue="{Binding CorrectionBackendChoice}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="230" Margin="0,0,12,12" /><ComboBox ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding CorrectionThreadChoice}" Width="85" Margin="0,0,0,12" AutomationProperties.Name="{local:T 'Correction CPU threads'}" /></WrapPanel>
            <CheckBox Content="{local:T 'Run Whisper and Canary in parallel'}" IsChecked="{Binding ParallelChoice}" Margin="0,0,0,16" />
            <WrapPanel><Button Content="{local:T 'Save these settings'}" Command="{Binding SaveBackendSettingsCommand}" Margin="0,0,12,10" /><Button Content="{local:T 'Find best settings with auto-tuning'}" Command="{Binding GoBenchmarkCommand}" Margin="0,0,0,10" /></WrapPanel>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsDiagnosticsPage, Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><Button Content="{local:T 'Refresh hardware information'}" Command="{Binding DetectHardwareCommand}" /><Button Content="{local:T 'Copy diagnostics'}" Command="{Binding CopyDiagnosticsCommand}" Margin="12,0,0,0" /></StackPanel><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="18" TextWrapping="Wrap" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:T 'Hardware diagnostics'}" /></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26"><StackPanel><TextBlock Text="{local:T 'Appearance'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{local:T 'Theme'}" FontWeight="SemiBold" Margin="0,14,0,8" /><ComboBox ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedTheme}" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{local:T 'Appearance theme'}" /><CheckBox Content="{local:T 'Pulse error alerts'}" IsChecked="{Binding AnimateErrors}" Margin="0,16,0,8" /><TextBlock Text="{Binding ThemeSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,9,0,24" /><TextBlock Text="{local:T 'Density'}" FontWeight="SemiBold" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Densities}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedDensity}" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{local:T 'Interface density'}" /><TextBlock Text="{local:T 'Language'}" FontWeight="SemiBold" Margin="0,24,0,8" /><ComboBox ItemsSource="{Binding UiLanguages}" SelectedValue="{Binding Language}" SelectedValuePath="Code" ItemTemplate="{StaticResource NativeNameItem}" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{local:T 'Interface language'}" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="{local:T 'Privacy'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{local:T 'Transcription runs on this computer. Downloading models, runtimes or updates, and checking for updates, connects to GitHub or Hugging Face.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24" /><Button Content="{local:T 'Read privacy policy'}" Click="ShowPrivacyPolicy" HorizontalAlignment="Left" Margin="0,14,0,0" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="{local:T 'Updates'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24" /><CheckBox Content="{local:T 'Check for updates automatically'}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,16,0,0" ToolTip="{local:T 'Once at startup, at most every 12 hours. Only the release information file is requested from GitHub; no recordings, transcripts or personal data are sent.'}" AutomationProperties.Name="{local:T 'Check for updates automatically'}" /><Button Content="{local:T 'Check for updates now'}" Command="{Binding CheckForUpdatesNowCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="{local:T 'Performance'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{local:T 'Resource profile'}" FontWeight="SemiBold" Margin="0,14,0,8" /><ComboBox ItemsSource="{Binding ResourceProfiles}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedResourceProfile}" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{local:T 'Resource profile'}" ToolTip="{local:T 'Auto uses Quiet on battery and Default when plugged in. Quiet uses half the CPU cores, Default leaves four free and Max leaves two free. Engines also run at lower priority, and the computer stays awake during a job.'}" /><TextBlock Text="{Binding ResourceSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="{local:T 'Silence and music'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{local:T 'Leave out stretches where no speech is detected. Singing counts as music, so turn this on for speech only.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24" /><CheckBox Content="{local:T 'Skip silence and music'}" IsChecked="{Binding SkipNonSpeech}" Margin="0,16,0,0" AutomationProperties.Name="{local:T 'Skip silence and music'}" ToolTip="{local:T 'Applies to new transcriptions and is kept for each job.'}" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="{local:T 'Correction model'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{local:T 'When Whisper and Canary produce different text, a small local AI model can choose between their results. If correction is turned off or its model has not been downloaded, Whisper\'s text is kept and the passage is marked for listening.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24" /><CheckBox Content="{local:T 'Let the correction model choose between the engines'}" IsChecked="{Binding UseCorrectionModel}" Margin="0,16,0,0" AutomationProperties.Name="{local:T 'Let the correction model choose between the engines'}" ToolTip="{local:T 'Changes Whisper\'s wording only when the correction model assigns at least 90% probability to Canary\'s candidate. In the tests so far against a known transcript it made no incorrect changes and no improvements. Applies to new transcriptions and is kept for each job.'}" /></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="{local:T 'Storage'}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,16" /><WrapPanel><Button Content="{local:T 'Choose projects folder'}" Tag="data" Click="ChooseStorageFolder" /><Button Content="{local:T 'Choose models folder'}" Tag="models" Click="ChooseStorageFolder" Margin="12,0,0,0" /></WrapPanel><TextBlock Text="{local:T 'Changes apply after restart.'}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" /></StackPanel></Border>
        </StackPanel>
      </Grid></ScrollViewer>
        <local:RemoteWorkspaceView Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding Remote}" Visibility="{Binding DataContext.IsRemotePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
        <Border Grid.Row="2" Visibility="{Binding IsReviewPage, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="20,12,20,16"><StackPanel>
            <MediaElement x:Name="Player" Source="{Binding AudioSource}" LoadedBehavior="Manual" UnloadedBehavior="Close" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" Height="0" />
            <local:WaveformView SourcePath="{Binding NormalizedAudioPath}" Height="48" Margin="0,0,0,10" MouseLeftButtonUp="WaveformSeek" ToolTip="{local:T 'Click to seek in the recording'}" />
            <Slider x:Name="SeekSlider" Minimum="0" PreviewMouseLeftButtonUp="OnSeek" AutomationProperties.Name="{local:T 'Audio position'}" />
            <WrapPanel Margin="0,10,0,0"><Button Content="{local:T 'Play region'}" Click="PlayRegionClick" /><Button Content="{local:T 'Pause'}" Click="PauseClick" Margin="8,0,0,0" /><Button Content="−5 s" Click="BackClick" Margin="8,0,0,0" /><Button Content="+5 s" Click="ForwardClick" Margin="8,0,0,0" /><ComboBox x:Name="SpeedPicker" Width="85" Margin="12,0,0,0" SelectedIndex="2" SelectionChanged="OnSpeedChanged" AutomationProperties.Name="{local:T 'Playback speed'}"><ComboBoxItem Content="0.5×" Tag="0.5" /><ComboBoxItem Content="0.75×" Tag="0.75" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="1.25×" Tag="1.25" /><ComboBoxItem Content="1.5×" Tag="1.5" /><ComboBoxItem Content="2×" Tag="2" /></ComboBox><TextBlock x:Name="PlayerTime" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /><CheckBox x:Name="FollowBox" Content="{local:T 'Follow the playback'}" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{local:T 'While the recording plays, the transcript moves with it: the words already said are coloured and the region being said is selected.'}" /></WrapPanel>
          </StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" MaxWidth="330" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding EngineStatus}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" /></Grid></Border>
  </Grid>
</Window>

