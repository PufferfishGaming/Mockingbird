<Window x:Class="TriAsr.App.TrustServerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App"
        Title="{local:T 'Trust this server?'}" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/TriASR.ico" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="14">
  <StackPanel Margin="28,24,28,24">
    <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
    <TextBlock x:Name="FingerprintLabel" Text="{local:T 'Fingerprint'}" FontWeight="SemiBold" Margin="0,18,0,6" />
    <Border x:Name="FingerprintBox" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6" Padding="12,10"><TextBlock x:Name="Fingerprint" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" /></Border>
    <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="Cancel" Content="{local:T 'Cancel'}" IsCancel="True" IsDefault="True" Click="OnCancel" />
      <Button x:Name="Trust" Content="{local:T 'Trust and connect'}" Click="OnTrust" Margin="10,0,0,0" />
    </WrapPanel>
  </StackPanel>
</Window>
