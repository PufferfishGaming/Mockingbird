<Window x:Class="TriAsr.App.ServerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App" Icon="Assets/TriASR.ico" Title="{x:Static local:AppInfo.WindowTitle}" Width="640" Height="800" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Closing="OnWindowClosing">
  <!-- DataContext: ShellViewModel. The Server edition: a small window that shows what the server is doing; the models and the speech programs live on this computer. -->
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="32" Height="32" Margin="0,0,13,0"><Path Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" Data="M8,16 L8,10 M13,23 L13,5 M18,19 L18,9 M23,16 L23,12" /></Border><TextBlock Text="{x:Static local:AppInfo.Name}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,2,0,0" /></StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="{local:T 'SERVING'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Host.IsListening, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{local:T 'NOT SERVING'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Host.IsListening}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1">
      <local:ErrorBanner x:Name="ErrorBanner" />
      <local:UpdateBanner />
      <local:SetupBanner />
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,24" MaxWidth="600">
        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="{Binding Host.DisplayName}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{local:T 'Not hosting. Press Start hosting to let other computers send recordings here.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Visibility="{Binding Host.Enabled, Converter={StaticResource InverseBoolVisibility}}" />
            <TextBlock Text="{local:T 'Waiting for recordings from other computers.'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Host.Enabled}" Value="True" /><Condition Binding="{Binding HasTranscriptionProgress}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Visibility="{Binding HasTranscriptionProgress, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TranscriptionStage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding TranscriptionProgressSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0" FontSize="12" /></Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding TranscriptionPercent, Mode=OneWay}" Height="8" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="{local:T 'Overall transcription progress'}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Visibility="{Binding ShowReadinessCard, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12,0,0"><Button Content="{local:T 'Download models'}" Command="{Binding InstallSelectedModelsCommand}" Margin="0,0,10,0" /><Button Content="{local:T 'Pause'}" Command="{Binding CancelModelCommand}" /></WrapPanel>
            <ProgressBar Value="{Binding ModelDownloadPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Model download progress'}" />
            <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <local:HostPanel DataContext="{Binding Host}" Margin="0,14,0,0" />
        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="{local:T 'Recent recordings'}" FontSize="17" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding Jobs}" MaxHeight="220" Margin="0,12,0,0" AutomationProperties.Name="{local:T 'Recent recordings'}">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SourcePath, Converter={x:Static local:FileNameConverter.Instance}}" ToolTip="{Binding SourcePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{local:Tr State}" Foreground="{DynamicResource AccentBrush}" Margin="16,0,0,0" VerticalAlignment="Center" /><Button Grid.Column="2" Style="{StaticResource ProjectDeleteButton}" Content="{local:T 'Delete'}" Click="DeleteProjectClick" Margin="12,0,0,0" ToolTip="{local:T 'Delete this project and its transcript'}" AutomationProperties.Name="{local:T 'Delete project'}" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{local:T 'Nothing here yet. Finished transcriptions are listed here.'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Jobs.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="{local:T 'Appearance'}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{local:T 'Theme'}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{local:T 'Appearance theme'}" />
            <TextBlock Text="{local:T 'Language'}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding UiLanguages}" SelectedValue="{Binding Language}" SelectedValuePath="Code" ItemTemplate="{StaticResource NativeNameItem}" AutomationProperties.Name="{local:T 'Interface language'}" />
            <TextBlock Text="{local:T 'Storage'}" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,0" />
            <TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,10" />
            <WrapPanel><Button Content="{local:T 'Choose projects folder'}" Tag="data" Click="ChooseStorageFolder" Margin="0,0,10,8" /><Button Content="{local:T 'Choose models folder'}" Tag="models" Click="ChooseStorageFolder" Margin="0,0,10,8" /></WrapPanel>
            <TextBlock Text="{local:T 'Changes apply after restart.'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            <Button Content="{local:T 'Read privacy policy'}" Click="ShowPrivacyPolicy" HorizontalAlignment="Left" Margin="0,18,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" MaxWidth="260" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding EngineStatus}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" /></Grid></Border>
  </Grid>
</Window>
