<UserControl x:Class="TriAsr.App.LinkCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: LinkCardModel. Paste the address of a video or audio on the web. Studio fetches the sound on this computer; the Client and Studio's Remote page ask the server to. -->
  <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26">
    <StackPanel>
      <TextBlock Text="{local:T 'Link'}" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
      <TextBlock Text="{local:T 'Web address'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
      <TextBox Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}" Padding="9" MaxLength="2000" AutomationProperties.Name="{local:T 'Web address'}">
        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RunCommand}" /></TextBox.InputBindings>
      </TextBox>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" />
        <Button Content="{local:T 'Cancel'}" Command="{Binding CancelCommand}" Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Cancel the link'}" />
      </StackPanel>
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="0,16,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Link progress'}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
      <Border Visibility="{Binding HasNote, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" />
          <Button Content="{Binding NoteActionLabel}" Command="{Binding NoteCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding HasNoteAction, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
