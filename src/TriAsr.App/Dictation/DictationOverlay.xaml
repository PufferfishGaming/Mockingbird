<Window x:Class="TriAsr.App.DictationOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" AutomationProperties.Name="{local:T 'Dictation'}">
  <!-- DataContext: DictationViewModel. The little window that floats above the other programs. It never takes the keyboard: the words are typed into the program the person was using. -->
  <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="26" Padding="10" Margin="8" MouseLeftButtonDown="OnDrag">
    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" /></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button Width="44" Height="44" Command="{Binding ToggleListeningCommand}" Cursor="Hand" AutomationProperties.Name="{local:T 'Start or stop dictation'}" ToolTip="{local:T 'Start or stop dictation'}">
        <Button.Template><ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Disc" Fill="{DynamicResource AccentBrush}" />
            <Path x:Name="Mic" Data="M0,6 A3.5,3.5 0 0 1 7,6 L7,10 A3.5,3.5 0 0 1 0,10 Z M-3,9 A6.5,6.5 0 0 0 10,9 M3.5,15.5 L3.5,19" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsListening}" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Opacity" Value="0.85" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
      </Button>
      <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" MinWidth="200" MaxWidth="260">
        <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level, Mode=OneWay}" Height="4" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="{local:T 'Microphone level'}" />
        <TextBlock Text="{Binding LastText}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
      <Button Grid.Column="2" Width="26" Height="26" Padding="0" VerticalAlignment="Top" Click="OnClose" Cursor="Hand" AutomationProperties.Name="{local:T 'Hide the dictation window'}" ToolTip="{local:T 'Hide the dictation window'}">
        <Button.Template><ControlTemplate TargetType="Button">
          <Grid Background="Transparent"><Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
        </ControlTemplate></Button.Template>
      </Button>
    </Grid>
  </Border>
</Window>
