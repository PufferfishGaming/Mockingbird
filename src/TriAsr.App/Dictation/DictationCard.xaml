<UserControl x:Class="TriAsr.App.DictationCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: DictationViewModel. Live dictation: a little window above the other programs types what is said where the cursor is. Studio uses its own speech programs; the Client uses the server's. -->
  <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26">
    <StackPanel>
      <TextBlock Text="{local:T 'Dictation'}" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="{local:T 'Speak in any program: a small window floats above your other programs, and every phrase you say is typed where your cursor is. Start and stop it with the button of that window or with the keys below.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
      <WrapPanel IsEnabled="{Binding CanChoose}">
        <StackPanel Margin="0,0,16,12"><TextBlock Text="{local:T 'Language'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="220" AutomationProperties.Name="{local:T 'Dictation language'}" ToolTip="{local:T 'Choosing the language is more reliable than detecting it, because a phrase is short. Whatever is said in another language is written translated into this one, unless that language is chosen as the second language.'}" /></StackPanel>
        <StackPanel Margin="0,0,16,12"><TextBlock Text="{local:T 'Second language'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding SecondLanguages}" SelectedValue="{Binding SelectedSecondLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="220" IsEnabled="{Binding CanChooseSecondLanguage}" AutomationProperties.Name="{local:T 'Second dictation language'}" ToolTip="{local:T 'If you switch between two languages, choose both: each phrase is written in the language it was spoken in, not translated. When the two are hard to tell apart, a phrase takes a moment longer.'}" ToolTipService.ShowOnDisabled="True" /></StackPanel>
        <StackPanel Margin="0,0,16,12"><TextBlock Text="{local:T 'How the words get in'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" ItemTemplate="{StaticResource TranslatedItem}" Width="190" AutomationProperties.Name="{local:T 'How the words get in'}" ToolTip="{local:T 'Typing sends the words key by key. Pasting is for the few programs that ignore typed words: it uses the clipboard for a moment.'}" /></StackPanel>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="{local:T 'Microphone'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="220" MaxWidth="320" AutomationProperties.Name="{local:T 'Microphone'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      </WrapPanel>
      <StackPanel Margin="0,4,0,16"><TextBlock Text="{local:T 'Keys to start and stop'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" /><local:KeybindBox DataContext="{Binding Keybind}" HorizontalAlignment="Left" /></StackPanel>
      <Button Style="{StaticResource PrimaryButton}" Content="{Binding OverlayButtonLabel}" Command="{Binding ToggleOverlayCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
      <Border Visibility="{Binding HasNote, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0"><TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" /></Border>
      <Border Visibility="{Binding HasHotkeyNote, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0"><TextBlock Text="{Binding HotkeyNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBrush}" /></Border>
    </StackPanel>
  </Border>
</UserControl>
