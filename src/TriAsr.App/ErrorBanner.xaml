<UserControl x:Class="TriAsr.App.ErrorBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- The error alert at the top of the window. DataContext: ShellViewModel. -->
  <Border x:Name="ErrorAlert" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="3" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Margin="16,10" Padding="18,14" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{local:T 'Error alert'}">
    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PulseError}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="ErrorPulse"><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.6" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="3x" FillBehavior="Stop" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ErrorPulse" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ErrorTitle}" Foreground="{DynamicResource ErrorBrush}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" /><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,6,16,0"><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" /></ScrollViewer></StackPanel><Button Grid.Column="1" Content="{local:T 'Dismiss'}" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top" AutomationProperties.Name="{local:T 'Dismiss error alert'}" /></Grid>
  </Border>
</UserControl>
