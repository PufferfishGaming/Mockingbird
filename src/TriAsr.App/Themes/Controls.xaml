<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!--
    The look of every window (Studio, Server, Client). Controls answer the pointer: a hover lights them up and a press sinks them a little,
    with short fades rather than jumps. Colours always come from the theme (LightTheme.xaml, DarkTheme.xaml, or Windows' high-contrast colours),
    so the fades animate the opacity of a layer in a theme colour, never a colour itself.
  -->
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <local:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility" />
  <!-- A choice from a list whose values stay English in the program (themes, presets, languages...) shown in the interface language. -->
  <DataTemplate x:Key="TranslatedItem"><TextBlock Text="{local:Tr .}" /></DataTemplate>
  <!-- The name of a language in that language, as a language picker shows it. -->
  <DataTemplate x:Key="NativeNameItem"><TextBlock Text="{Binding NativeName}" /></DataTemplate>
  <Style x:Key="FocusIndicator"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="9" Margin="-3" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>

  <!-- ==== buttons ============================================================================================================== -->
  <!-- Every button: a soft surface that turns to the accent tint under the pointer and sinks a little while pressed. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="20,11" /><Setter Property="MinHeight" Value="42" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Press" /></Grid.RenderTransform>
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
        <Border x:Name="Hover" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Opacity="0" />
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The one button on a page that does the main thing: filled with the accent colour; it brightens and lifts under the pointer. -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="26,13" /><Setter Property="MinHeight" Value="46" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Press" /></Grid.RenderTransform>
        <Border x:Name="Shadow" Background="{DynamicResource AccentBrush}" CornerRadius="10" Opacity="0" Margin="2,4,2,-3"><Border.Effect><BlurEffect Radius="12" /></Border.Effect></Border>
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" />
        <Border x:Name="Hover" Background="{DynamicResource AccentHoverBrush}" CornerRadius="10" Opacity="0" />
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style></ContentPresenter.Resources></ContentPresenter>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.18" />
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A button that stays pressed while its panel is shown (the Client's Servers button): like a button, tinted while it is on. -->
  <Style x:Key="ToggleChip" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="16,8" /><Setter Property="MinHeight" Value="36" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Grid>
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
        <Border x:Name="Hover" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Opacity="0" />
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The small Delete button on a project row (Studio, the Server window): shown only for a project that is finished, has failed or was cancelled. -->
  <Style x:Key="ProjectDeleteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="14,7" /><Setter Property="MinHeight" Value="34" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Complete"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ==== lists =============================================================================================================== -->
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
  <!-- A row of a list (the navigation, projects, transcript regions...): it lights up under the pointer; the chosen one is tinted and marked on the left. -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,13" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Grid>
        <Border x:Name="Selected" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="8" Opacity="0" />
        <Border x:Name="Hover" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Opacity="0" />
        <Border x:Name="Marker" Background="{DynamicResource AccentBrush}" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9" Opacity="0" />
        <ContentPresenter Margin="{TemplateBinding Padding}" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" /><Setter TargetName="Selected" Property="Opacity" Value="1" /><Setter TargetName="Marker" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A radio button drawn as a tab: the chosen one has the accent tint; the others light up under the pointer. -->
  <Style x:Key="TabRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid>
        <Border x:Name="Checked" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="8" Opacity="0" />
        <Border x:Name="Hover" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Opacity="0" />
        <ContentPresenter Margin="{TemplateBinding Padding}" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Checked" Property="Opacity" Value="1" /><Setter TargetName="Hover" Property="Visibility" Value="Collapsed" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><DockPanel>
      <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusIndicator}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal" Background="Transparent"><Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="2,0,12,0" RenderTransformOrigin="0.4,0.5"><Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform></Path><ContentPresenter VerticalAlignment="Center" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsChecked" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle" To="90" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Body" Visibility="Collapsed" />
    </DockPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ==== choosing and typing ================================================================================================= -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Padding" Value="12,9" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Body" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" /><Setter Property="MinHeight" Value="42" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
          <Border x:Name="Hover" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Opacity="0" />
          <Path x:Name="Arrow" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
        </Grid><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /><Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Margin="13,9,34,9" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,0,8,8">
          <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" /></Border.Effect>
          <ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
        </Border>
      </Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Text boxes: a rounded field whose border warms under the pointer and turns to the accent while typing. -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="SelectionOpacity" Value="0.35" /><Setter Property="Padding" Value="9,8" /><Setter Property="MinHeight" Value="40" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Grid>
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
        <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /></Trigger>
        <Trigger Property="AcceptsReturn" Value="True"><Setter Property="VerticalContentAlignment" Value="Top" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Padding" Value="9,8" /><Setter Property="MinHeight" Value="40" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Grid>
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
        <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Check boxes: a rounded box that fills with the accent colour and draws its tick when checked. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid Width="20" Height="20" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
          <Border x:Name="Box" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.5" CornerRadius="5" />
          <Border x:Name="Fill" Background="{DynamicResource AccentBrush}" CornerRadius="5" Opacity="0" />
          <Path x:Name="Tick" Data="M4.5,10.5 L8.5,14 L15.5,6" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" />
          <Rectangle x:Name="Dash" Width="10" Height="2.2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentTextBrush}" Opacity="0" />
        </Grid>
        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Fill" Property="Opacity" Value="1" /><Setter TargetName="Dash" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ==== the playback slider ================================================================================================== -->
  <Style x:Key="SliderPlayedButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="MinHeight" Value="26" /><Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent" VerticalAlignment="Center">
        <Border x:Name="Rail" Height="5" CornerRadius="3" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPlayedButton}" /></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButton}" /></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="Knob"><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Grid Width="18" Height="18" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Grow" /></Grid.RenderTransform>
              <Ellipse Fill="{DynamicResource AccentBrush}" /><Ellipse Fill="{DynamicResource SurfaceElevatedBrush}" Margin="5" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.12" /><DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" /><DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ==== slim scroll bars ===================================================================================================== -->
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Body" Background="{DynamicResource TextMutedBrush}" CornerRadius="4" Opacity="0.45" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.75" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.9" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Width" Value="10" /><Setter Property="MinWidth" Value="10" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="Transparent" Padding="2">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" /></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" /></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
        </Track>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="10" /><Setter Property="MinHeight" Value="10" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Border Background="Transparent" Padding="2">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" /></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" /></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==== tabs, tables, tips, progress ======================================================================================== -->
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="Padding" Value="18,12" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusIndicator}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBody" Padding="{TemplateBinding Padding}" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBody" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBody" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Setter TargetName="TabBody" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="TabBody" Property="BorderThickness" Value="0,0,0,2" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="Padding" Value="12,10" /></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Padding" Value="10,7" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger></Style.Triggers></Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Padding" Value="11,8" /><Setter Property="MaxWidth" Value="420" /><Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0,0,6,6">
        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.16" /></Border.Effect>
        <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style></ContentPresenter.Resources></ContentPresenter>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" /></Style>
</ResourceDictionary>
