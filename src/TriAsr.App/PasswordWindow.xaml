<Window x:Class="TriAsr.App.PasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App"
        Title="{local:T 'Password'}" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/TriASR.ico" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="14" FocusManager.FocusedElement="{Binding ElementName=Entry}">
  <StackPanel Margin="28,24,28,24">
    <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
    <PasswordBox x:Name="Entry" Margin="0,16,0,0" Padding="9" AutomationProperties.Name="{local:T 'Password'}" />
    <CheckBox x:Name="RememberBox" Content="{local:T 'Remember it on this computer'}" Margin="0,14,0,0" />
    <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="{local:T 'Cancel'}" IsCancel="True" />
      <Button Content="{local:T 'Connect'}" IsDefault="True" Click="OnConnect" Margin="10,0,0,0" />
    </WrapPanel>
  </StackPanel>
</Window>
