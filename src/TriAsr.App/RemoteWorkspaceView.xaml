<UserControl x:Class="TriAsr.App.RemoteWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App"
             PreviewKeyDown="OnReviewKey">
  <!-- DataContext: RemoteWorkspaceViewModel. The pages of a connected server; nothing here runs a speech model. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <!-- Not connected -->
    <Border Grid.RowSpan="3" Padding="48" Visibility="{Binding NotConnected, Converter={StaticResource BoolVisibility}}">
      <StackPanel VerticalAlignment="Center" MaxWidth="520">
        <TextBlock Text="{local:T 'No server connected'}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{local:T 'Choose a server in the panel on the right and press Connect. Recordings are sent to that server and its speech programs do the work; the transcripts come back here.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="24" />
      </StackPanel>
    </Border>

    <!-- Connected -->
    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding ServerName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <RadioButton GroupName="RemoteTabs" Content="{local:T 'New transcription'}" IsChecked="{Binding IsNewTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="New" Padding="14,8" Margin="0,0,8,0" Style="{StaticResource TabRadio}" />
          <RadioButton GroupName="RemoteTabs" Content="{local:T 'Projects'}" IsChecked="{Binding IsProjectsTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="Projects" Padding="14,8" Margin="0,0,8,0" Style="{StaticResource TabRadio}" />
          <RadioButton GroupName="RemoteTabs" Content="{local:T 'Review'}" IsChecked="{Binding IsReviewTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="Review" Padding="14,8" Margin="0,0,8,0" Style="{StaticResource TabRadio}" />
          <RadioButton GroupName="RemoteTabs" Content="{local:T 'Notes'}" IsChecked="{Binding IsNotesTab, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="Notes" Padding="14,8" Style="{StaticResource TabRadio}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}">
      <Grid Margin="24,20,24,24">
        <!-- New -->
        <StackPanel local:Motion.FadeIn="True" Visibility="{Binding IsNewTab, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="28" AllowDrop="True" Drop="OnFileDrop">
            <StackPanel>
              <TextBlock Text="{local:T 'Drop audio or video here'}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="{local:T 'WAV, MP3, M4A, FLAC, MP4, MKV and more'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
              <Button Content="{local:T 'Select file'}" Click="SelectFileClick" HorizontalAlignment="Left" AutomationProperties.Name="{local:T 'Select media file'}" />
              <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
              <StackPanel Margin="0,20,0,0"><TextBlock Text="{local:T 'Language'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="{local:T 'Speech language'}" /></StackPanel>
              <StackPanel Margin="0,14,0,0"><TextBlock Text="{local:T 'Second language'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding SecondLanguages}" SelectedValue="{Binding SelectedSecondLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="240" HorizontalAlignment="Left" IsEnabled="{Binding CanChooseSecondLanguage}" AutomationProperties.Name="{local:T 'Second speech language'}" ToolTip="{local:T 'If the recording switches between two languages, choose both: each part is written in the language it was spoken in, not translated. Finding the parts takes a little longer.'}" ToolTipService.ShowOnDisabled="True" /></StackPanel>
              <StackPanel Margin="0,14,0,0" Visibility="{Binding CanTellSpeakersApart, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{local:T 'Speakers'}" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding SpeakerChoices}" SelectedValue="{Binding SelectedSpeakers}" SelectedValuePath="Value" ItemTemplate="{StaticResource TranslatedItem}" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="{local:T 'Speakers'}" ToolTip="{local:T 'Mockingbird can tell the voices apart and mark each part of the transcript with its speaker. If you know how many people speak, choose the number: exactly that many are kept.'}" /></StackPanel>
              <Border Visibility="{Binding HasServerNote, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,20,0,0"><TextBlock Text="{Binding ServerNote}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" /></Border>
              <StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="{local:T 'Send to server'}" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" /></StackPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding SendPercent, Mode=OneWay}" Height="6" Margin="0,16,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" Visibility="{Binding IsSending, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Upload progress'}" />
              <TextBlock Text="{Binding SendStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
          <local:RecorderCard DataContext="{Binding Recorder}" Margin="0,18,0,0" />
          <local:LinkCard DataContext="{Binding Link}" Margin="0,18,0,0" />
          <local:DictationCard DataContext="{Binding Dictation}" Margin="0,18,0,0" />
        </StackPanel>

        <!-- Projects -->
        <StackPanel local:Motion.FadeIn="True" Visibility="{Binding IsProjectsTab, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{local:T 'Click a finished project to open its transcript.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <local:SearchResultsPanel Visibility="{Binding CanSearch, Converter={StaticResource BoolVisibility}}" />
          <StackPanel Visibility="{Binding HasProjectSearch, Converter={StaticResource InverseBoolVisibility}}">
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" MinHeight="200" PreviewMouseLeftButtonUp="ProjectClick" PreviewKeyDown="ProjectKeyDown" AutomationProperties.Name="{local:T 'Recordings on the server'}">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" />
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding Created}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                  <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{local:T 'Delete'}" Click="DeleteProjectClick" Padding="12,6" VerticalAlignment="Center" Visibility="{Binding CanDelete, Converter={StaticResource BoolVisibility}}" ToolTip="{local:T 'Delete this project and its transcript'}" AutomationProperties.Name="{local:T 'Delete project'}" />
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{local:T 'Nothing here yet. Finished transcriptions are listed here.'}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,0" Visibility="{Binding HasNoJobs, Converter={StaticResource BoolVisibility}}" />
          </StackPanel>
          <WrapPanel Margin="0,18,0,0"><Button Content="{local:T 'Open transcript'}" Command="{Binding OpenSelectedCommand}" /><Button Content="{local:T 'Cancel'}" Command="{Binding CancelSelectedCommand}" Margin="12,0,0,0" /></WrapPanel>
        </StackPanel>

        <!-- Notes -->
        <StackPanel local:Motion.FadeIn="True" Visibility="{Binding IsNotesTab, Converter={StaticResource BoolVisibility}}">
          <local:NotesView DataContext="{Binding Notes}" />
        </StackPanel>

        <!-- Review -->
        <StackPanel local:Motion.FadeIn="True" Visibility="{Binding IsReviewTab, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{local:T 'Open a finished recording from Projects to review its transcript.'}" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding NoReview, Converter={StaticResource BoolVisibility}}" />
          <StackPanel Visibility="{Binding HasReview, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding ReviewName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ReviewSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <WrapPanel Margin="0,14,0,16"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="9" AutomationProperties.Name="{local:T 'Search transcript'}" ToolTip="{local:T 'Search final and original text'}" /><CheckBox Content="{local:T 'Needs listening'}" IsChecked="{Binding UncertainOnly}" VerticalAlignment="Center" Margin="16,0,16,0" /><Button Content="{local:T 'Save edits'}" Command="{Binding SaveReviewCommand}" /><ComboBox ItemsSource="{Binding ExportModes}" ItemTemplate="{StaticResource TranslatedItem}" SelectedItem="{Binding SelectedExportMode}" Width="150" Margin="12,0,0,0" AutomationProperties.Name="{local:T 'Export mode'}" ToolTip="{local:T 'Readable adjusts spacing without changing the spoken words. Strict Verbatim exports the current transcript without readability adjustments.'}" /><Button Content="{local:T 'Export…'}" Click="ExportClick" Margin="12,0,0,0" /></WrapPanel>
            <local:SpeakerNamesPanel DataContext="{Binding SpeakerNaming}" />
            <local:SummaryPanel DataContext="{Binding Summary}" />
            <ListBox x:Name="RegionList" ItemsSource="{Binding ReviewItems}" SelectedItem="{Binding SelectedRegion}" MaxHeight="235" MinHeight="100" AutomationProperties.Name="{local:T 'Transcript regions'}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Time}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SpeakerLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{local:Tr Source, Kind=Source}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel><local:KaraokeTextBlock Grid.Column="1" KaraokeText="{Binding Text}" Progress="{Binding PlayProgress}" TextWrapping="Wrap" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TabControl Margin="0,18,0,0" Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
              <TabItem Header="{local:T 'Final'}"><StackPanel Margin="16"><TextBlock Text="{Binding SelectedRegion.Evidence}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" /><WrapPanel Margin="0,0,0,12"><Button Content="{local:T 'Use Whisper · 1'}" Command="{Binding UseWhisperCommand}" /><Button Content="{local:T 'Use Canary · 2'}" Command="{Binding UseCanaryCommand}" Margin="8,0,0,0" /><Button Content="{local:T 'Restore automatic result · 3'}" Command="{Binding UseAutomaticCommand}" Margin="8,0,0,0" /></WrapPanel><TextBox x:Name="TranscriptEditor" Text="{Binding SelectedRegion.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Padding="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="{local:T 'Edit selected transcript region'}" /></StackPanel></TabItem>
              <TabItem Header="{local:T 'Comparison'}"><StackPanel Margin="16"><TextBlock Text="{local:T 'WHISPER'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBox Text="{Binding SelectedRegion.Whisper, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,5,0,12" /><TextBlock Text="{Binding SelectedRegion.CanaryHeading}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBox Text="{Binding SelectedRegion.Canary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,5,0,12" /><TextBlock Text="{local:T 'FINAL'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedRegion.Text}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></TabItem>
              <TabItem Header="{local:T 'Raw'}"><StackPanel Margin="16"><TextBlock Text="{local:T 'Original engine output (read-only).'}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" /><TextBox Text="{Binding RawWhisper, Mode=OneWay}" IsReadOnly="True" MaxHeight="250" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8" /><TextBox Text="{Binding RawCanary, Mode=OneWay}" IsReadOnly="True" MaxHeight="250" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8" Margin="0,12,0,0" /></StackPanel></TabItem>
            </TabControl>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- The player under the review -->
    <Border Grid.Row="2" Visibility="{Binding ShowPlayer, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="20,12,20,16">
      <StackPanel>
        <MediaElement x:Name="Player" Source="{Binding AudioSource}" LoadedBehavior="Manual" UnloadedBehavior="Close" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" Height="0" />
        <TextBlock Text="{Binding AudioStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8" Visibility="{Binding HasAudioStatus, Converter={StaticResource BoolVisibility}}" />
        <local:WaveformView SourcePath="{Binding NormalizedAudioPath}" Height="48" Margin="0,0,0,10" MouseLeftButtonUp="WaveformSeek" ToolTip="{local:T 'Click to seek in the recording'}" />
        <Slider x:Name="SeekSlider" Minimum="0" PreviewMouseLeftButtonUp="OnSeek" AutomationProperties.Name="{local:T 'Audio position'}" />
        <WrapPanel Margin="0,10,0,0"><Button Content="{local:T 'Play region'}" Click="PlayRegionClick" /><Button Content="{local:T 'Pause'}" Click="PauseClick" Margin="8,0,0,0" /><Button Content="−5 s" Click="BackClick" Margin="8,0,0,0" /><Button Content="+5 s" Click="ForwardClick" Margin="8,0,0,0" /><ComboBox x:Name="SpeedPicker" Width="85" Margin="12,0,0,0" SelectedIndex="2" SelectionChanged="OnSpeedChanged" AutomationProperties.Name="{local:T 'Playback speed'}"><ComboBoxItem Content="0.5×" Tag="0.5" /><ComboBoxItem Content="0.75×" Tag="0.75" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="1.25×" Tag="1.25" /><ComboBoxItem Content="1.5×" Tag="1.5" /><ComboBoxItem Content="2×" Tag="2" /></ComboBox><TextBlock x:Name="PlayerTime" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /><CheckBox x:Name="FollowBox" Content="{local:T 'Follow the playback'}" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{local:T 'While the recording plays, the transcript moves with it: the words already said are coloured and the region being said is selected.'}" /></WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
