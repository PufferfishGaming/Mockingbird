<UserControl x:Class="TriAsr.App.SearchResultsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!--
    Searching every transcript (Studio's Projects page, a server's Projects tab). The DataContext has ProjectSearchText, ProjectSearchStatus, HasProjectSearch,
    SearchResults (SearchHitRow) and the commands OpenSearchHit and OpenSearchPassage.
  -->
  <StackPanel>
    <TextBlock Text="{local:T 'Search all transcripts'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
    <TextBox Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="520" HorizontalAlignment="Left" Margin="0,0,0,14" AutomationProperties.Name="{local:T 'Search all transcripts'}" ToolTip="{local:T 'Finds words in every transcript and in the names of the projects. Capital letters and accents do not matter.'}" />
    <StackPanel Visibility="{Binding HasProjectSearch, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding ProjectSearchStatus}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
      <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False" AutomationProperties.Name="{local:T 'Search results'}">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,10">
            <StackPanel>
              <Button Style="{StaticResource SearchRowButton}" Command="{Binding DataContext.OpenSearchHitCommand, RelativeSource={RelativeSource AncestorType=local:SearchResultsPanel}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding Created}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding MatchesText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="12,0,0,0" /></StackPanel></StackPanel>
              </Button>
              <ItemsControl ItemsSource="{Binding Passages}" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Style="{StaticResource SearchRowButton}" Command="{Binding DataContext.OpenSearchPassageCommand, RelativeSource={RelativeSource AncestorType=local:SearchResultsPanel}}" CommandParameter="{Binding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding Time}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontFamily="Consolas" /><TextBlock Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolVisibility}}" /></StackPanel>
                      <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /><Run Text="{Binding After, Mode=OneWay}" /></TextBlock>
                    </Grid>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
