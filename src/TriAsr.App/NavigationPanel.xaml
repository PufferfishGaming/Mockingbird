<UserControl x:Class="TriAsr.App.NavigationPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: ShellViewModel. The sidebar of a window: its pages, with the Advanced ones shown on demand. The window has an IsNavigationCompact property: when narrow, only the icons are shown. -->
  <DockPanel LastChildFill="True"><Button DockPanel.Dock="Bottom" x:Name="AdvancedToggle" Command="{Binding ToggleAdvancedCommand}" Padding="12,10" Margin="0,10,0,0" ToolTip="{local:T 'Languages, backends, benchmark, diagnostics and terminal'}" AutomationProperties.Name="{local:T 'Advanced pages'}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal"><Grid Width="22"><Path Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6" Width="12" Height="7" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M0,0 L5,5 L10,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowAdvanced}" Value="True"><Setter Property="Data" Value="M0,5 L5,0 L10,5" /></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid><TextBlock Text="{local:T 'Advanced'}" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button><ListBox x:Name="NavigationList" ItemsSource="{Binding Pages, RelativeSource={RelativeSource AncestorType=local:NavigationPanel}}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="{local:T 'Main navigation'}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Advanced}" Value="True" /><Condition Binding="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Name}" Value="Remote server" /><Condition Binding="{Binding DataContext.Servers.HasConnection, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{local:Tr Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="{Binding Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{local:Tr Name}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
</UserControl>
