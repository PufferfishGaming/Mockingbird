<UserControl x:Class="TriAsr.App.UpdateBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- The "update available" banner. DataContext: ShellViewModel. -->
  <Border Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="24,14" AutomationProperties.Name="{local:T 'Update available'}" AutomationProperties.LiveSetting="Polite">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" /><TextBlock Text="{Binding UpdateDetail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,16,0" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent, Mode=OneWay}" Height="6" Margin="0,10,16,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Update download progress'}" /></StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="380"><Button Content="{local:T 'Update now'}" Command="{Binding InstallUpdateCommand}" Margin="0,0,10,4" ToolTip="{local:T 'Downloads the new version, checks it, closes the app, installs it and reopens it. Your projects and models are kept.'}" /><Button Content="{local:T 'Cancel'}" Command="{Binding CancelUpdateCommand}" Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,4" /><Button Content="{local:T 'Later'}" Command="{Binding DismissUpdateCommand}" Margin="0,0,10,4" /><Button Content="{local:T 'Skip this version'}" Command="{Binding SkipUpdateCommand}" Margin="0,0,0,4" /></WrapPanel>
    </Grid>
  </Border>
</UserControl>
