<UserControl x:Class="TriAsr.App.LanguagesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: ShellViewModel. Setting up the models of a language. The same page in Studio and in the Server window. -->
  <StackPanel>
    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel>
      <TextBlock Text="{local:T '100 languages, one model'}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{local:T 'Whisper can transcribe all the languages listed below. Canary provides a second transcription for 25 of them. Transcripts in the other languages are marked for listening.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,16" />
      <TextBlock Text="{Binding SavedLanguageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" />
      <TextBox Text="{Binding LanguageSearch, UpdateSourceTrigger=PropertyChanged}" Padding="10" ToolTip="{local:T 'Search a language or code'}" AutomationProperties.Name="{local:T 'Search language expansions'}" />
      <ListBox ItemsSource="{Binding ExpansionLanguages}" SelectedItem="{Binding SelectedExpansionLanguage}" ItemTemplate="{StaticResource TranslatedItem}" MaxHeight="260" Margin="0,12,0,16" AutomationProperties.Name="{local:T 'Available language expansions'}" />
      <TextBlock Text="{Binding LanguageCoverage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
      <WrapPanel><Button Content="{local:T 'Set up this language'}" Command="{Binding InstallLanguageSupportCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Use this language'}" Command="{Binding UseExpansionLanguageCommand}" Margin="0,0,10,10" /><Button Content="{local:T 'Pause'}" Command="{Binding CancelModelCommand}" Margin="0,0,0,10" /></WrapPanel>
      <ProgressBar Maximum="100" Value="{Binding ModelDownloadPercent, Mode=OneWay}" Height="8" Visibility="{Binding IsModelBusy, Converter={StaticResource BoolVisibility}}" />
      <TextBlock Text="{Binding LanguageSetupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,10" />
      <TextBlock Text="{Binding ModelProgress}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
