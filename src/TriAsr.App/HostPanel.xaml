<UserControl x:Class="TriAsr.App.HostPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: HostViewModel. Hosting this computer's transcription for other computers and programs. -->
  <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
    <StackPanel>
      <TextBlock Text="{local:T 'Host a server'}" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="{local:T 'Other computers send their recordings here and the speech programs run on this computer. Works while the app is open.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
      <Button Style="{StaticResource PrimaryButton}" Content="{local:T 'Start hosting'}" Command="{Binding ToggleHostingCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T 'Start hosting'}" ToolTip="{local:T 'Starts the server with the settings below. Other computers can then send recordings to this one.'}">
        <Button.Visibility><Binding Path="Enabled" Converter="{StaticResource InverseBoolVisibility}" /></Button.Visibility>
      </Button>
      <Grid Margin="0,16,0,0" Visibility="{Binding Enabled, Converter={StaticResource BoolVisibility}}">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" /><TextBlock Text="{local:T 'Hosting'}" FontWeight="SemiBold" FontSize="15" Margin="9,0,0,0" /></StackPanel>
        <Button Grid.Column="1" Content="{local:T 'Stop hosting'}" Command="{Binding ToggleHostingCommand}" Padding="18,9" AutomationProperties.Name="{local:T 'Stop hosting'}" />
      </Grid>
      <TextBlock Text="{local:T 'Server name'}" FontWeight="SemiBold" Margin="0,14,0,6" FontSize="12" />
      <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Padding="8" AutomationProperties.Name="{local:T 'Server name'}" ToolTip="{local:T 'How this server appears to other computers. Empty uses the name of this computer.'}" />
      <TextBlock Text="{local:T 'Password (optional)'}" FontWeight="SemiBold" Margin="0,14,0,6" FontSize="12" />
      <TextBox Text="{Binding Password, UpdateSourceTrigger=LostFocus}" Padding="8" FontFamily="Consolas" AutomationProperties.Name="{local:T 'Password (optional)'}" ToolTip="{local:T 'Without a password anyone who can reach this server may use it. Share the password only with the people who should.'}" />
      <WrapPanel Margin="0,8,0,0"><Button Content="{local:T 'Make a password'}" Command="{Binding GeneratePasswordCommand}" Padding="10,6" /><Button Content="{local:T 'No password'}" Command="{Binding ClearPasswordCommand}" Padding="10,6" Margin="8,0,0,0" /></WrapPanel>
      <TextBlock Text="{local:T 'Who can use it'}" FontWeight="SemiBold" Margin="0,14,0,6" FontSize="12" />
      <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="9" Padding="3" ToolTip="{local:T 'Without the network only programs on this computer can connect. With it the server announces itself on the network and every connection is encrypted. Windows may ask once whether to allow it.'}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <RadioButton Style="{StaticResource TabRadio}" GroupName="HostReach" IsChecked="{Binding LocalOnly}" Padding="10,8" AutomationProperties.Name="{local:T 'This computer only'}"><TextBlock Text="{local:T 'This computer only'}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" /></RadioButton>
          <RadioButton Grid.Column="1" Style="{StaticResource TabRadio}" GroupName="HostReach" IsChecked="{Binding AllowNetwork}" Padding="10,8" AutomationProperties.Name="{local:T 'Computers on the network'}"><TextBlock Text="{local:T 'Computers on the network'}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" /></RadioButton>
        </Grid>
      </Border>
      <TextBlock Text="{local:T 'Port'}" FontWeight="SemiBold" Margin="0,14,0,6" FontSize="12" />
      <TextBox Text="{Binding PortText, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" Padding="8" AutomationProperties.Name="{local:T 'Port'}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" FontSize="12" />
      <WrapPanel Margin="0,8,0,0"><Button Content="{local:T 'Copy address'}" Command="{Binding CopyAddressCommand}" Padding="10,6" /><Button Content="{local:T 'Open web page'}" Command="{Binding OpenWebPageCommand}" Padding="10,6" Margin="8,0,0,0" Visibility="{Binding Enabled, Converter={StaticResource BoolVisibility}}" ToolTip="{local:T 'Opens the web page of this server in your browser. The same page works from any computer that can reach the server.'}" /></WrapPanel>
      <StackPanel Visibility="{Binding HasPhoneCode, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
        <TextBlock Text="{local:T 'Open on a phone'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
        <TextBlock Text="{local:T 'Point the camera of a phone on the same network at the code to open the web page of this server. The first time, the browser of the phone warns about the certificate of the server: open the details and continue.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
        <Border Background="White" CornerRadius="6" HorizontalAlignment="Left" Margin="0,10,0,0"><Image Source="{Binding PhoneCode}" Width="176" Height="176" RenderOptions.EdgeMode="Aliased" AutomationProperties.Name="{local:T 'QR code of the server address'}" /></Border>
        <ComboBox ItemsSource="{Binding PhoneAddresses}" SelectedItem="{Binding SelectedPhoneAddress}" HorizontalAlignment="Left" MinWidth="230" Margin="0,10,0,0" Visibility="{Binding HasSeveralPhoneAddresses, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{local:T 'Address in the code'}" ToolTip="{local:T 'This computer has more than one network address. Choose the one of the network the phone is on.'}" />
        <TextBlock Text="{Binding SelectedPhoneAddress}" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" Visibility="{Binding HasSeveralPhoneAddresses, Converter={StaticResource InverseBoolVisibility}}" />
      </StackPanel>
      <TextBlock Text="{local:T 'To open the web page on a phone, choose Computers on the network.'}" Visibility="{Binding ShowPhoneHint, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" />
      <TextBlock Text="{local:T 'Links'}" FontWeight="SemiBold" Margin="0,14,0,6" FontSize="12" />
      <TextBlock Text="{local:T 'Computers that use this server can send it the address of a video or audio on the web. The server downloads the sound itself and transcribes it. This works only while the server has a password.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
      <TextBlock Text="{Binding LinkHelper.Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
      <Button Content="{Binding LinkHelper.ActionLabel}" Command="{Binding LinkHelper.RunCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0" />
      <StackPanel Visibility="{Binding HasFingerprint, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{local:T 'Identity'}" FontWeight="SemiBold" Margin="0,14,0,6" FontSize="12" ToolTip="{local:T 'Computers that connect for the first time are shown this fingerprint and should check that it matches. If it ever changes without your doing, do not connect.'}" />
        <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
        <WrapPanel Margin="0,8,0,0"><Button Content="{local:T 'Copy'}" Command="{Binding CopyFingerprintCommand}" Padding="10,6" /><Button Content="{local:T 'New identity'}" Command="{Binding NewIdentityCommand}" Padding="10,6" Margin="8,0,0,0" ToolTip="{local:T 'Makes a new certificate. Computers that trusted the old one will ask again.'}" /></WrapPanel>
      </StackPanel>
      <Expander Header="{local:T 'Try it from a terminal'}" Margin="0,14,0,0"><TextBox Text="{Binding Example, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Padding="8" Margin="0,8,0,0" AutomationProperties.Name="{local:T 'Example commands'}" /></Expander>
    </StackPanel>
  </Border>
</UserControl>
