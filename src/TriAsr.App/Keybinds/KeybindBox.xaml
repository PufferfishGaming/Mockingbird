<UserControl x:Class="TriAsr.App.KeybindBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: KeybindViewModel. Shows the keys now; "Change keys" waits for the keys the person presses, and "Done" (clicked with the mouse) keeps them. -->
  <StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding NotCapturing, Converter={StaticResource BoolVisibility}}">
      <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,0" MinHeight="42" MinWidth="150">
        <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </Border>
      <Button Content="{local:T 'Change keys'}" Command="{Binding BeginCommand}" Margin="10,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Border x:Name="Panel" Visibility="{Binding IsCapturing, Converter={StaticResource BoolVisibility}}" Focusable="True" FocusVisualStyle="{x:Null}" Padding="18" CornerRadius="8" BorderThickness="2" Background="{DynamicResource SurfaceSecondaryBrush}"
            PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp" PreviewMouseDown="OnPanelMouseDown" IsVisibleChanged="OnPanelVisibleChanged" GotKeyboardFocus="OnFocusChanged" LostKeyboardFocus="OnFocusChanged"
            AutomationProperties.Name="{local:T 'Press the keys you want to use'}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock Text="{Binding CaptureText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{local:T 'Press the keys together, then click Done.'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock x:Name="FocusHint" Text="{local:T 'Click here first, then press the keys.'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Assertive" />
        <WrapPanel Margin="0,14,0,0">
          <Button Style="{StaticResource PrimaryButton}" Content="{local:T 'Done'}" Command="{Binding DoneCommand}" Focusable="False" Margin="0,0,10,0" />
          <Button Content="{local:T 'Cancel'}" Command="{Binding CancelCommand}" Focusable="False" Margin="0,0,10,0" />
          <Button Content="{local:T 'Use the usual keys'}" Command="{Binding ResetCommand}" Focusable="False" Margin="0,0,10,0" Visibility="{Binding HasDefault, Converter={StaticResource BoolVisibility}}" />
          <Button Content="{local:T 'Turn off'}" Command="{Binding TurnOffCommand}" Focusable="False" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
