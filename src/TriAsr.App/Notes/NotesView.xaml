<UserControl x:Class="TriAsr.App.NotesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TriAsr.App">
  <!-- DataContext: NotesViewModel. A list of notes and an editor; a note can also be recorded: every phrase that is spoken is added to the end of it. Studio shows this computer's notes, the Client and the Remote server page the server's. -->
  <Grid>
    <!-- no server connected -->
    <Border Visibility="{Binding NoSource, Converter={StaticResource BoolVisibility}}" Padding="0,8,0,0">
      <TextBlock Text="{Binding NoSourceText}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
    </Border>

    <Grid Visibility="{Binding HasSource, Converter={StaticResource BoolVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <!-- the list -->
      <DockPanel Margin="0,0,22,0" IsEnabled="{Binding CanSwitch}">
        <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" Content="{local:T 'New note'}" Command="{Binding NewNoteCommand}" HorizontalAlignment="Left" Margin="0,0,0,14" />
        <TextBlock DockPanel.Dock="Top" Text="{local:T 'No notes yet. Make one, then type or record into it.'}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ListBox x:Name="NoteList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" VerticalAlignment="Top" MinHeight="120" MaxHeight="620" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{local:T 'Notes'}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PreviewLine}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding Updated}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- the open note -->
      <Grid Grid.Column="1">
        <TextBlock Text="{local:T 'Open a note from the list, or make a new one.'}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Visibility="{Binding NoNoteOpen, Converter={StaticResource BoolVisibility}}" />
        <StackPanel Visibility="{Binding HasOpenNote, Converter={StaticResource BoolVisibility}}">
          <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" Padding="12,9" MaxLength="200" AutomationProperties.Name="{local:T 'Title of the note'}" ToolTip="{local:T 'Title of the note'}" />

          <Border Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" />
          </Border>

          <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding RecordButtonLabel}" Command="{Binding ToggleRecordingCommand}" Margin="0,0,16,8" Padding="22,10" />
                <StackPanel Margin="0,0,16,8"><TextBlock Text="{local:T 'Language'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" /><ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="200" IsEnabled="{Binding CanSwitch}" AutomationProperties.Name="{local:T 'Language of the recording'}" ToolTip="{local:T 'Choosing the language is more reliable than detecting it, because a phrase is short. Whatever is said in another language is written translated into this one, unless that language is chosen as the second language.'}" /></StackPanel>
                <StackPanel Margin="0,0,16,8" IsEnabled="{Binding CanSwitch}"><TextBlock Text="{local:T 'Second language'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" /><ComboBox ItemsSource="{Binding SecondLanguages}" SelectedValue="{Binding SelectedSecondLanguage}" SelectedValuePath="Code" ItemTemplate="{StaticResource TranslatedItem}" Width="200" IsEnabled="{Binding CanChooseSecondLanguage}" AutomationProperties.Name="{local:T 'Second language of the recording'}" ToolTip="{local:T 'If you switch between two languages, choose both: each phrase is written in the language it was spoken in, not translated. When the two are hard to tell apart, a phrase takes a moment longer.'}" ToolTipService.ShowOnDisabled="True" /></StackPanel>
                <StackPanel Margin="0,0,0,8"><TextBlock Text="{local:T 'Microphone'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" /><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="200" MaxWidth="300" IsEnabled="{Binding CanSwitch}" AutomationProperties.Name="{local:T 'Microphone'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
              </WrapPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level, Mode=OneWay}" Height="4" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="{local:T 'Microphone level'}">
                <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsListening}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
              </ProgressBar>
              <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowsKeybind, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{local:T 'Keys to start and stop recording'}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                <local:KeybindBox DataContext="{Binding Keybind}" HorizontalAlignment="Left" />
              </StackPanel>
              <Border Visibility="{Binding HasNote, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0"><TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" /></Border>
              <Border Visibility="{Binding HasHotkeyNote, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0"><TextBlock Text="{Binding HotkeyNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBrush}" /></Border>
            </StackPanel>
          </Border>

          <TextBox x:Name="NoteEditor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="340" VerticalScrollBarVisibility="Auto" Padding="14" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="{local:T 'Text of the note'}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
              <Button Content="{local:T 'Copy text'}" Click="CopyClick" Margin="0,0,10,0" />
              <Button Content="{local:T 'Delete'}" Click="DeleteClick" IsEnabled="{Binding CanSwitch}" ToolTip="{local:T 'Delete this note'}" AutomationProperties.Name="{local:T 'Delete note'}" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
