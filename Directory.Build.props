<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath Condition="'$(ArtifactsPath)' == ''">bin\x64\$(Configuration)\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.13</Version>
    <!-- Preserve the original assembly identity and increase file versions above legacy 1.0.0 binaries. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.$(Version)</FileVersion>
    <Product>Mockingbird Studio</Product>
    <AssemblyTitle>Mockingbird Studio</AssemblyTitle>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
